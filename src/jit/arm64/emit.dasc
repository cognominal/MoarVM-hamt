        MVMint32 src_off = WORK_OFF(src);
        | ldr d0, [x21, #src_off]
        | fcmp d0, #0.0
        | cset TMP1, ne
        | cset TMP2, vs
        | orr TMP1, TMP1, TMP2
        | str TMP1, [x21, #dst_off]
        break;
