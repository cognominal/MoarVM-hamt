        MVMint16 reg_b = ins->operands[1].reg.orig;
        MVMint16 reg_c = ins->operands[2].reg.orig;
        MVMint32 a_off = WORK_OFF(reg_a);
        MVMint32 b_off = WORK_OFF(reg_b);
        MVMint32 c_off = WORK_OFF(reg_c);
        | ldr d0, [x21, #b_off]
        | ldr d1, [x21, #c_off]
        switch (op) {
