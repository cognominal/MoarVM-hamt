/* -*-C-*- */
#include "moar.h"
#include "jit/internal.h"
#include "dasm_arm64.h"

|.arch arm64
|.actionlist actions
|.section code, data
|.globals MVM_JIT_LABEL_

/* Typed register aliases — binds C struct type to a base register.
 * Field access TC->foo expands to [x19, #offsetof(MVMThreadContext, foo)]. */
|.type TC,         MVMThreadContext, x19
|.type WORK,       MVMRegister,      x21
|.type CU,         MVMCompUnit,      x20
|.type FRAME,      MVMFrame
|.type OBJECT,     MVMObject
|.type STABLE,     MVMSTable
|.type STOOGE,     MVMObjectStooge
|.type VMARRAY,    MVMArray
|.type CARRAY,     MVMCArray
|.type MVMINSTANCE, MVMInstance
|.type STATICFRAME, MVMStaticFrame
|.type OBJECTPTR,  MVMObject*
|.type CODE,       MVMCode
|.type CFUNCTION,  MVMCFunction
|.type REPR,       MVMREPROps
|.type MVMDISPINLINECACHE, MVMDispInlineCache
|.type MVMDISPINLINECACHEENTRY, MVMDispInlineCacheEntry
|.type COLLECTABLE, MVMCollectable
|.type REGISTER,   MVMRegister
|.type P6OPAQUE,   MVMP6opaque
|.type P6OBODY,    MVMP6opaqueBody
|.type CONTEXT,    MVMContext
|.type HLLCONFIG,  MVMHLLConfig
|.type BIGINTBODY, MVMP6bigintBody
|.type ARGCTX,     MVMArgProcContext
|.type CALLSITE,   MVMCallsite
|.type U16,        MVMuint16
|.type SCREF,      MVMSerializationContext
|.type SCREFBODY,  MVMSerializationContextBody
|.type MVMITER,    MVMIter
|.type CONTAINERSPEC, MVMContainerSpec
|.type STORAGESPEC, MVMStorageSpec
|.type MVMACTIVEHANDLERS, MVMActiveHandler
|.type STRING, MVMString

/* ---- Register conventions ------------------------------------------------
 * x0-x7  : ARG1-ARG8 / caller-saved
 * x8     : indirect result register (avoid)
 * x9-x15 : TMP1-TMP7 / caller-saved temporaries
 * x16    : FUNCTION / IP0 (linker scratch, used for callp)
 * x17    : spare / IP1
 * x18    : platform register (reserved, do not touch)
 * x19    : TC  (callee-saved — MVMThreadContext*)
 * x20    : CU  (callee-saved — MVMCompUnit*)
 * x21    : WORK (callee-saved — MVMRegister* work array)
 * x29    : FP  (frame pointer)
 * x30    : LR  (link register)
 * v0     : RVF / FP argument 0
 * v1-v7  : FP arguments
 * v8-v15 : callee-saved FP
 * v16-v31: caller-saved FP temporaries
 * ----------------------------------------------------------------------- */
|.define ARG1,     x0
|.define ARG2,     x1
|.define ARG3,     x2
|.define ARG4,     x3
|.define ARG5,     x4
|.define ARG6,     x5
|.define ARG1F,    v0
|.define ARG2F,    v1
|.define TMP1,     x9
|.define TMP2,     x10
|.define TMP3,     x11
|.define TMP4,     x12
|.define TMP5,     x13
|.define TMP6,     x14
|.define TMP7,     x15
|.define FUNCTION, x16
|.define RV,       x0
|.define RVF,      v0

/* Call a C function whose address is known at JIT compile time.
 * Stores the pointer in the data section and loads it PC-relatively. */
|.macro callp, funcptr
|.data
|5:
|.quad (uintptr_t)(funcptr)
|.code
| ldr FUNCTION, <5
| adr x17, >9
| str x17, [sp, #40]
| blr FUNCTION
| ldr x17, [sp, #40]
| br x17
|9:
|.endmacro

/* GC safe-point: if gc_status != 0, call into the GC. */
|.macro gc_sync_point
| ldr TMP1, TC->gc_status
| cbz TMP1, >1
| mov ARG1, x19
| callp &MVM_gc_enter_from_interrupt
|1:
|.endmacro

|.macro get_spesh_slot, reg, idx
| ldr reg, TC->cur_frame
| ldr reg, FRAME:reg->effective_spesh_slots
| ldr reg, [reg, #((idx)*8)]
|.endmacro

|.macro get_vmnull, reg
| ldr reg, TC->instance
| ldr reg, MVMINSTANCE:reg->VMNull
|.endmacro

|.macro get_cur_op, reg
| ldr reg, TC->interp_cur_op
| ldr reg, [reg]
|.endmacro

|.macro get_string, reg, idx
|| MVM_cu_ensure_string_decoded(tc, jg->sg->sf->body.cu, idx);
| ldr reg, CU->body.strings
| ldr reg, [reg, #((idx)*8)]
|.endmacro

/* Test if an object is a type object (non-concrete).
 * After this macro, NZCV is set: b.ne if type object, b.eq if concrete. */
|.macro test_type_object, reg
| ldrb w15, OBJECT:reg->header.flags1
| tst x15, #MVM_CF_TYPE_OBJECT
|.endmacro

|.macro get_stable, out, in
| ldr out, OBJECT:in->st
|.endmacro

|.macro get_repr, out, in
| get_stable out, in
| ldr out, STABLE:out->REPR
|.endmacro

/* Write barrier: skip if root not gen2, ref null, or ref already gen2 */
|.macro check_wb, root, ref, lbl
| ldrb w17, COLLECTABLE:root->flags2
| tbz x17, #1, lbl
| cbz ref, lbl
| ldrb w17, COLLECTABLE:ref->flags2
| tbnz x17, #1, lbl
|.endmacro

|.macro hit_wb, obj, value
| mov ARG3, value
| mov ARG2, obj
| mov ARG1, x19
| callp &MVM_gc_write_barrier_hit_by
|.endmacro

|.macro throw_adhoc, msg
| mov ARG1, x19
|.data
|6:
| .quad (uintptr_t)(msg)
|.code
| ldr ARG2, <6
| callp &MVM_exception_throw_adhoc
|.endmacro

|.macro cmp_repr_id, obj, tmp, id
| get_repr tmp, obj
| ldr w17, REPR:tmp->ID
| cmp w17, #id
|.endmacro


#define WORK_OFF(r) ((MVMint32)((r) * (MVMint32)sizeof(MVMRegister)))

MVMint32 MVM_jit_support(void) {
    return 1;
}

const unsigned char * MVM_jit_actions(void) {
    /* ARM64 DynASM emits unsigned int[] rather than unsigned char[] */
    return (const unsigned char *)actions;
}

/* ---- Prologue ------------------------------------------------------------
 * Called once per JIT compilation unit.  Sets up the C stack frame,
 * saves callee-saved registers, loads TC/CU/WORK, then jumps to the
 * entry label passed in as ARG3 (x2).
 *
 * Stack frame layout (160 bytes, 16-byte aligned):
 *   [sp+  0]: x29 (saved FP)
 *   [sp+  8]: x30 (saved LR  — outer return address, restored by epilogue)
 *   [sp+ 16]: x19 (saved TC caller value)
 *   [sp+ 24]: x20 (saved CU caller value)
 *   [sp+ 32]: x21 (saved WORK caller value)
 *   [sp+ 40]: trampoline slot (jit_return_address points here)
 *   [sp+ 48]: MVMArgs.callsite   } pre-allocated for runccode/runbytecode
 *   [sp+ 56]: MVMArgs.source     }   so those functions never adjust sp,
 *   [sp+ 64]: MVMArgs.map        }   keeping [sp+40] as the live trampoline
 *   [sp+ 72]: padding            }   slot for callp.
 *   [sp+ 80..159]: reserved (unused; formerly held arg_indices)
 *
 * Trampoline: tc->jit_return_address = &sp[40].  callp stores its reentry
 * label at [sp+40]; MVM_jit_code_trampoline overwrites it with exit_label.
 * The epilogue restores LR from [sp+8] (never touched by the trampoline).
 * ----------------------------------------------------------------------- */
void MVM_jit_emit_prologue(MVMThreadContext *tc, MVMJitCompiler *compiler,
                           MVMJitGraph *jg) {
    |.code
    | stp x29, x30, [sp, #-160]!
    | mov x29, sp
    | stp x19, x20, [sp, #16]
    | str x21, [sp, #32]
    /* Load interpreter state from arguments */
    | mov x19, ARG1
    | mov x20, ARG2
    | ldr TMP1, TC->cur_frame
    | ldr x21, FRAME:TMP1->work
    /* Trampoline: save outer LR copy to [sp+40]; point jit_return_address there */
    if (!jg->no_trampoline) {
        | str x30, [sp, #40]
        | add TMP1, sp, #40
        | str TMP1, TC->jit_return_address
    }
    /* Jump to the continuation label supplied by the caller */
    | br ARG3
}

/* ---- Epilogue ------------------------------------------------------------
 * The ->exit global label is the single exit point for all JIT code.
 * Clears jit_return_address, restores callee-saved registers and
 * returns to the C caller via the original saved LR at [sp+8].
 * ----------------------------------------------------------------------- */
void MVM_jit_emit_epilogue(MVMThreadContext *tc, MVMJitCompiler *compiler,
                           MVMJitGraph *jg) {
    | ->exit:
    if (!jg->no_trampoline) {
        | str xzr, TC->jit_return_address
    }
    | ldr x21, [sp, #32]
    | ldp x19, x20, [sp, #16]
    | ldp x29, x30, [sp], #160
    | ret
}

/* ---- Labels and branches ------------------------------------------------ */

void MVM_jit_emit_label(MVMThreadContext *tc, MVMJitCompiler *compiler,
                        MVMJitGraph *jg, MVMint32 label) {
    | =>(label):
}

void MVM_jit_emit_branch(MVMThreadContext *tc, MVMJitCompiler *compiler,
                         MVMint32 label) {
    | b =>(label)
}

void MVM_jit_emit_block_branch(MVMThreadContext *tc, MVMJitCompiler *compiler,
                               MVMJitGraph *jg, MVMJitBranch *branch) {
    MVMSpeshIns *ins  = branch->ins;
    MVMint32     name = branch->dest;
    | gc_sync_point
    if (ins == NULL || ins->info->opcode == MVM_OP_goto) {
        if (name == MVM_JIT_BRANCH_EXIT) {
            | b ->exit
        } else {
            | b =>(name)
        }
    } else {
        MVMint16 val = ins->operands[0].reg.orig;
        MVMint32 val_off = WORK_OFF(val);
        switch (ins->info->opcode) {
        case MVM_OP_if_i:
            | ldr TMP1, [x21, #val_off]
            | cbnz TMP1, =>(name)
            break;
        case MVM_OP_unless_i:
            | ldr TMP1, [x21, #val_off]
            | cbz TMP1, =>(name)
            break;
        case MVM_OP_if_n:
            | ldr d0, [x21, #val_off]
            | fcmp d0, #0.0
            | bvs =>(name)
            | bne =>(name)
            break;
        case MVM_OP_unless_n:
            | ldr d0, [x21, #val_off]
            | fcmp d0, #0.0
            | bvs >1
            | bne >1
            | b =>(name)
            |1:
            break;
        case MVM_OP_if_s0:
        case MVM_OP_unless_s0:
            | mov ARG1, x19
            | ldr ARG2, [x21, #val_off]
            | callp &MVM_coerce_istrue_s
            if (ins->info->opcode == MVM_OP_unless_s0) {
                | cbz RV, =>(name)
            } else {
                | cbnz RV, =>(name)
            }
            break;
        case MVM_OP_if_s:
            | ldr TMP1, [x21, #val_off]
            | cbz TMP1, >1
            | ldr w9, STRING:TMP1->body.num_graphs
            | cbz x9, >1
            | b =>(name)
            |1:
            break;
        case MVM_OP_unless_s:
            | ldr TMP1, [x21, #val_off]
            | cbz TMP1, =>(name)
            | ldr w9, STRING:TMP1->body.num_graphs
            | cbz x9, =>(name)
            break;
        case MVM_OP_ifnonnull:
            | ldr TMP1, [x21, #val_off]
            | cbz TMP1, >1
            | get_vmnull TMP2
            | cmp TMP1, TMP2
            | beq >1
            | b =>(name)
            |1:
            break;
        case MVM_OP_indexat:
        case MVM_OP_indexnat: {
            MVMint16 offset  = ins->operands[1].reg.orig;
            MVMuint32 str_idx = ins->operands[2].lit_str_idx;
            MVMint32 off_off = WORK_OFF(offset);
            | mov ARG1, x19
            | ldr ARG2, [x21, #val_off]
            | ldr ARG3, [x21, #off_off]
            | get_string ARG4, str_idx
            | callp &MVM_string_char_at_in_string
            | cmn RV, #1
            if (ins->info->opcode == MVM_OP_indexat) {
                | ble =>(name)
            } else {
                | bne =>(name)
            }
            break;
        }
        default:
            MVM_oops(tc, "ARM64 JIT: can't handle conditional branch <%s>", ins->info->name);
        }
    }
}

void MVM_jit_emit_all_bb_jumps(MVMThreadContext *tc, MVMJitCompiler *compiler,
                               MVMint32 name) {
    MVMuint32 bbidx;
    | b >1
    for (bbidx = 0; bbidx < compiler->graph->sg->num_bbs; bbidx++) {
        | b =>(bbidx)
    }
    |1:
}

/* ---- emit_call_c helpers ------------------------------------------------ */

static void load_call_arg(MVMThreadContext *tc, MVMJitCompiler *compiler,
                          MVMJitGraph *jg, MVMJitCallArg arg) {
    switch (arg.type) {
    case MVM_JIT_INTERP_VAR:
        switch (arg.v.ivar) {
        case MVM_JIT_INTERP_TC:
            | mov TMP6, x19
            break;
        case MVM_JIT_INTERP_CU:
            | mov TMP6, x20
            break;
        case MVM_JIT_INTERP_FRAME:
            | ldr TMP6, TC->cur_frame
            break;
        case MVM_JIT_INTERP_PARAMS:
            | ldr TMP6, TC->cur_frame
            | add TMP6, TMP6, #offsetof(MVMFrame, params)
            break;
        case MVM_JIT_INTERP_CALLER:
            | ldr TMP6, TC->cur_frame
            | ldr TMP6, FRAME:TMP6->caller
            break;
        }
        break;
    case MVM_JIT_REG_VAL:
    case MVM_JIT_REG_VAL_F: {
        MVMint32 offset = arg.v.reg * sizeof(MVMRegister);
        | ldr TMP6, [x21, #offset]
        break;
    }
    case MVM_JIT_REG_ADDR: {
        MVMint32 offset = arg.v.reg * sizeof(MVMRegister);
        | add TMP6, x21, #offset
        break;
    }
    case MVM_JIT_STR_IDX:
        | get_string TMP6, arg.v.lit_i64
        break;
    case MVM_JIT_LITERAL:
    case MVM_JIT_LITERAL_64:
    case MVM_JIT_LITERAL_PTR:
    case MVM_JIT_LITERAL_F:
        | .data
        | 6:
        | .quad (uintptr_t)(arg.v.lit_i64)
        | .code
        | ldr TMP6, <6
        break;
    case MVM_JIT_REG_STABLE: {
        MVMint32 offset = arg.v.reg * sizeof(MVMRegister);
        | ldr TMP6, [x21, #offset]
        | ldr TMP6, OBJECT:TMP6->st
        break;
    }
    case MVM_JIT_REG_OBJBODY: {
        MVMint32 offset = arg.v.reg * sizeof(MVMRegister);
        | ldr TMP6, [x21, #offset]
        | add TMP6, TMP6, #offsetof(MVMObjectStooge, data)
        break;
    }
    case MVM_JIT_REG_DYNIDX:
        | get_cur_op TMP6
        | ldrh w14, [x14, #(arg.v.reg * 2)]
        | ldr x14, [x21, x14, lsl #3]
        break;
    case MVM_JIT_DATA_LABEL:
        | adr TMP6, =>(arg.v.lit_i64)
        break;
    case MVM_JIT_ARG_I64:
    case MVM_JIT_PARAM_I64: {
        MVMint32 offset = (MVMint32)(arg.v.lit_i64 * sizeof(MVMRegister));
        | ldr TMP6, [x21, #offset]
        break;
    }
    case MVM_JIT_ARG_I64_RW:
    case MVM_JIT_PARAM_I64_RW: {
        MVMint32 offset = (MVMint32)(arg.v.lit_i64 * sizeof(MVMRegister));
        | add TMP6, x21, #offset
        break;
    }
    case MVM_JIT_ARG_DOUBLE:
    case MVM_JIT_PARAM_DOUBLE: {
        MVMint32 offset = (MVMint32)(arg.v.lit_i64 * sizeof(MVMRegister));
        | ldr TMP6, [x21, #offset]
        break;
    }
    case MVM_JIT_ARG_PTR:
    case MVM_JIT_PARAM_PTR: {
        MVMint32 offset = (MVMint32)(arg.v.lit_i64 * sizeof(MVMRegister));
        | ldr TMP6, [x21, #offset]
        | ldr TMP6, STOOGE:TMP6->data
        break;
    }
    case MVM_JIT_ARG_VMARRAY:
    case MVM_JIT_PARAM_VMARRAY: {
        MVMint32 offset = (MVMint32)(arg.v.lit_i64 * sizeof(MVMRegister));
        | ldr TMP6, [x21, #offset]
        | ldr TMP6, VMARRAY:TMP6->body.slots
        break;
    }
    case MVM_JIT_PARAM_CARRAY: {
        MVMint32 offset = (MVMint32)(arg.v.lit_i64 * sizeof(MVMRegister));
        | ldr TMP6, [x21, #offset]
        | ldr TMP6, CARRAY:TMP6->body.storage
        break;
    }
    case MVM_JIT_SPESH_SLOT_VALUE:
        | get_spesh_slot TMP6, arg.v.lit_i64
        break;
    case MVM_JIT_STACK_VALUE: {
        MVMint32 offset = 40 + (MVMint32)(arg.v.lit_i64 * 8);
        | ldr TMP6, [x29, #offset]
        break;
    }
    default:
        MVM_oops(tc, "ARM64 JIT: unknown call arg type %d", arg.type);
    }
}

static void emit_gpr_arg(MVMThreadContext *tc, MVMJitCompiler *compiler, MVMint32 i) {
    switch (i) {
    case 0:
        | mov ARG1, TMP6
        break;
    case 1:
        | mov ARG2, TMP6
        break;
    case 2:
        | mov ARG3, TMP6
        break;
    case 3:
        | mov ARG4, TMP6
        break;
    case 4:
        | mov ARG5, TMP6
        break;
    case 5:
        | mov ARG6, TMP6
        break;
    case 6:
        | mov x6, TMP6
        break;
    case 7:
        | mov x7, TMP6
        break;
    default:
        MVM_oops(tc, "ARM64 JIT: too many GPR call args (%d)", i);
    }
}

static void emit_fpr_arg(MVMThreadContext *tc, MVMJitCompiler *compiler, MVMint32 i) {
    switch (i) {
    case 0:
        | fmov d0, x14
        break;
    case 1:
        | fmov d1, x14
        break;
    case 2:
        | fmov d2, x14
        break;
    case 3:
        | fmov d3, x14
        break;
    case 4:
        | fmov d4, x14
        break;
    case 5:
        | fmov d5, x14
        break;
    case 6:
        | fmov d6, x14
        break;
    case 7:
        | fmov d7, x14
        break;
    default:
        MVM_oops(tc, "ARM64 JIT: too many FPR call args (%d)", i);
    }
}

/* Returns the sp adjustment made for stack args (must be undone by caller after
 * the call).  call_c operations that don't dispatch MoarVM frames use blr
 * directly, so sp adjustment here is safe. */
static MVMint32 emit_arm64_callargs(MVMThreadContext *tc, MVMJitCompiler *compiler,
                                    MVMJitGraph *jg, MVMJitCallArg args[], MVMint32 num_args) {
    MVMint32 num_gpr = 0, num_fpr = 0, num_stack = 0, i;
    MVMJitCallArg in_gpr[8], in_fpr[8], in_stack[8];

    for (i = 0; i < num_args; i++) {
        switch (args[i].type) {
        case MVM_JIT_INTERP_VAR:
        case MVM_JIT_REG_VAL:
        case MVM_JIT_REG_ADDR:
        case MVM_JIT_REG_OBJBODY:
        case MVM_JIT_REG_STABLE:
        case MVM_JIT_REG_DYNIDX:
        case MVM_JIT_STR_IDX:
        case MVM_JIT_LITERAL:
        case MVM_JIT_LITERAL_64:
        case MVM_JIT_LITERAL_PTR:
        case MVM_JIT_DATA_LABEL:
        case MVM_JIT_ARG_I64:
        case MVM_JIT_ARG_I64_RW:
        case MVM_JIT_ARG_PTR:
        case MVM_JIT_ARG_VMARRAY:
        case MVM_JIT_PARAM_I64:
        case MVM_JIT_PARAM_I64_RW:
        case MVM_JIT_PARAM_PTR:
        case MVM_JIT_PARAM_VMARRAY:
        case MVM_JIT_PARAM_CARRAY:
        case MVM_JIT_SPESH_SLOT_VALUE:
        case MVM_JIT_STACK_VALUE:
            if (num_gpr < 8) in_gpr[num_gpr++] = args[i];
            else if (num_stack < 8) in_stack[num_stack++] = args[i];
            else MVM_oops(tc, "ARM64 JIT: too many GPR arguments (max 16)");
            break;
        case MVM_JIT_ARG_DOUBLE:
        case MVM_JIT_PARAM_DOUBLE:
        case MVM_JIT_REG_VAL_F:
        case MVM_JIT_LITERAL_F:
            if (num_fpr < 8) in_fpr[num_fpr++] = args[i];
            else MVM_oops(tc, "ARM64 JIT: too many FPR arguments");
            break;
        default:
            MVM_oops(tc, "ARM64 JIT: unknown arg type %d in callargs", args[i].type);
        }
    }

    for (i = 0; i < num_gpr; i++) {
        load_call_arg(tc, compiler, jg, in_gpr[i]);
        emit_gpr_arg(tc, compiler, i);
    }
    for (i = 0; i < num_fpr; i++) {
        load_call_arg(tc, compiler, jg, in_fpr[i]);
        emit_fpr_arg(tc, compiler, i);
    }

    /* Stack args (AAPCS64: extra args at [SP+0], [SP+8], ... at call time).
     * These functions don't dispatch MoarVM frames, so adjusting sp is safe. */
    MVMint32 stack_frame_size = 0;
    if (num_stack > 0) {
        stack_frame_size = (num_stack * 8 + 15) & ~15;
        | sub sp, sp, #stack_frame_size
        for (i = 0; i < num_stack; i++) {
            load_call_arg(tc, compiler, jg, in_stack[i]);
            | str TMP6, [sp, #(i * 8)]
        }
    }
    return stack_frame_size;
}

/* ARM64 register class helpers.
 * X0-X30 (0-30) are GPRs; V0-V31 (31-62) are FP registers. */
#define ARM64_IS_GPR(x) ((unsigned)(x) < 31u)
#define ARM64_IS_FPR(x) ((unsigned)(x) >= 31u)
#define ARM64_GPR_NUM(x) ((x))
#define ARM64_FPR_NUM(x) ((x) - 31)

/* ---- Helpers for emit_primitive ----------------------------------------- */

static void arm64_mov64_tmp1(MVMThreadContext *tc, MVMJitCompiler *compiler, MVMuint64 val) {
    MVMuint32 c0 = (MVMuint32)(val         & 0xFFFFu);
    MVMuint32 c1 = (MVMuint32)((val >> 16) & 0xFFFFu);
    MVMuint32 c2 = (MVMuint32)((val >> 32) & 0xFFFFu);
    MVMuint32 c3 = (MVMuint32)((val >> 48) & 0xFFFFu);
    | movz x9, #c0
    if (c1)
        | movk x9, #c1, lsl #16
    if (c2)
        | movk x9, #c2, lsl #32
    if (c3)
        | movk x9, #c3, lsl #48
}

static int arm64_try_emit_gen2_ref(MVMThreadContext *tc, MVMJitCompiler *compiler,
                                    MVMJitGraph *jg, MVMObject *obj, MVMint16 reg) {
    if (!(obj->header.flags2 & MVM_CF_SECOND_GEN))
        return 0;
    MVMint32 dst_off = WORK_OFF(reg);
    arm64_mov64_tmp1(tc, compiler, (MVMuint64)(uintptr_t)obj);
    | str TMP1, [x21, #dst_off]
    return 1;
}

static void arm64_emit_fastcreate(MVMThreadContext *tc, MVMJitCompiler *compiler,
                                   MVMJitGraph *jg, MVMSpeshIns *ins) {
    MVMuint16 size     = ins->operands[1].lit_i16;
    MVMint16 spesh_idx = ins->operands[2].lit_i16;
    | mov ARG1, x19
    | mov ARG2, #size
    | callp &MVM_gc_allocate_nursery
    | get_spesh_slot TMP1, spesh_idx
    | str TMP1, OBJECT:RV->st
    | movz w10, #size
    | strh w10, OBJECT:RV->header.size
    | ldr w10, TC->thread_id
    | str w10, OBJECT:RV->header.owner
}

void MVM_jit_emit_primitive(MVMThreadContext *tc, MVMJitCompiler *compiler,
                             MVMJitGraph *jg, MVMJitPrimitive *prim) {
    MVMSpeshIns *ins = prim->ins;
    MVMuint16 op = ins->info->opcode;
    switch (op) {
    case MVM_OP_const_i64_16:
    case MVM_OP_const_i64_32: {
        MVMint32 reg = ins->operands[0].reg.orig;
        MVMint64 val = (op == MVM_OP_const_i64_16 ? (MVMint64)ins->operands[1].lit_i16
                                                   : (MVMint64)ins->operands[1].lit_i32);
        MVMint32 dst_off = WORK_OFF(reg);
        arm64_mov64_tmp1(tc, compiler, (MVMuint64)val);
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_const_i64: {
        MVMint32 reg = ins->operands[0].reg.orig;
        MVMint64 val = ins->operands[1].lit_i64;
        MVMint32 dst_off = WORK_OFF(reg);
        arm64_mov64_tmp1(tc, compiler, (MVMuint64)val);
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_const_n64: {
        MVMint16 reg = ins->operands[0].reg.orig;
        MVMint64 valbytes = ins->operands[1].lit_i64;
        MVMint32 dst_off = WORK_OFF(reg);
        arm64_mov64_tmp1(tc, compiler, (MVMuint64)valbytes);
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_inf:
    case MVM_OP_neginf:
    case MVM_OP_nan: {
        MVMint16 reg = ins->operands[0].reg.orig;
        MVMint32 dst_off = WORK_OFF(reg);
        MVMRegister tmp;
        if (op == MVM_OP_nan)
            tmp.n64 = MVM_num_nan(tc);
        else if (op == MVM_OP_inf)
            tmp.n64 = MVM_num_posinf(tc);
        else
            tmp.n64 = MVM_num_neginf(tc);
        arm64_mov64_tmp1(tc, compiler, (MVMuint64)tmp.i64);
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_const_s: {
        MVMint16 reg = ins->operands[0].reg.orig;
        MVMuint32 idx = ins->operands[1].lit_str_idx;
        MVMStaticFrame *sf = jg->sg->sf;
        MVMString *s = MVM_cu_string(tc, sf->body.cu, idx);
        if (!arm64_try_emit_gen2_ref(tc, compiler, jg, (MVMObject*)s, reg)) {
            MVMint32 dst_off = WORK_OFF(reg);
            | get_string TMP1, idx
            | str TMP1, [x21, #dst_off]
        }
        break;
    }
    case MVM_OP_null:
    case MVM_OP_sp_resumption: {
        MVMint16 reg = ins->operands[0].reg.orig;
        MVMint32 dst_off = WORK_OFF(reg);
        | get_vmnull TMP1
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_getwhat:
    case MVM_OP_getwho: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 obj = ins->operands[1].reg.orig;
        MVMint32 obj_off = WORK_OFF(obj);
        MVMint32 dst_off = WORK_OFF(dst);
        | ldr TMP1, [x21, #obj_off]
        | ldr TMP1, OBJECT:TMP1->st
        if (op == MVM_OP_getwho) {
            | ldr TMP1, STABLE:TMP1->WHO
            | cbnz TMP1, >1
            | get_vmnull TMP1
            |1:
        } else {
            | ldr TMP1, STABLE:TMP1->WHAT
        }
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_getlex:
    case MVM_OP_sp_getlex_o:
    case MVM_OP_sp_getlex_ins: {
        MVMuint16 *lexical_types;
        MVMStaticFrame *sf = jg->sg->sf;
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 idx = ins->operands[1].lex.idx;
        MVMint16 out = ins->operands[1].lex.outers;
        MVMint16 i;
        MVMint32 dst_off = WORK_OFF(dst);
        | ldr TMP6, TC->cur_frame
        for (i = 0; i < out; i++) {
            | ldr TMP6, FRAME:TMP6->outer
            sf = sf->body.outer;
        }
        /* NB: the DynASM form `FRAME:TMP1->env` silently emits no
         * instruction here, so load env via an explicit offsetof. */
        | ldr TMP5, [TMP6, #offsetof(MVMFrame, env)]
        {
            MVMint32 env_off = idx * (MVMint32)sizeof(MVMRegister);
            | ldr TMP5, [TMP5, #env_off]
        }
        lexical_types = (!out && jg->sg->lexical_types ?
                         jg->sg->lexical_types :
                         sf->body.lexical_types);
        if (lexical_types[idx] == MVM_reg_obj) {
            | cbnz TMP5, >1
            | mov ARG1, x19
            | mov ARG2, TMP6
            | mov ARG3, #idx
            | callp &MVM_frame_vivify_lexical
            | mov TMP5, RV
            |1:
        }
        | str TMP5, [x21, #dst_off]
        break;
    }
    case MVM_OP_sp_getlexvia_o:
    case MVM_OP_sp_getlexvia_ins: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 idx = ins->operands[1].lit_ui16;
        MVMint16 out = ins->operands[2].lit_ui16;
        MVMint16 via = ins->operands[3].reg.orig;
        MVMint16 i;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 via_off = WORK_OFF(via);
        | ldr TMP6, [x21, #via_off]
        | ldr TMP6, CODE:TMP6->body.outer
        for (i = 1; i < out; i++)
            | ldr TMP6, FRAME:TMP6->outer
        /* NB: the DynASM form `FRAME:TMP6->env` silently emits no
         * instruction here, so load env via an explicit offsetof. */
        | ldr TMP5, [TMP6, #offsetof(MVMFrame, env)]
        {
            MVMint32 env_off = idx * (MVMint32)sizeof(MVMRegister);
            | ldr TMP5, [TMP5, #env_off]
        }
        if (op == MVM_OP_sp_getlexvia_o) {
            | cbnz TMP5, >1
            | mov ARG1, x19
            | mov ARG2, TMP6
            | mov ARG3, #idx
            | callp &MVM_frame_vivify_lexical
            | mov TMP5, RV
            |1:
        }
        | str TMP5, [x21, #dst_off]
        break;
    }
    case MVM_OP_sp_bindlexvia_os:
    case MVM_OP_sp_bindlexvia_in: {
        MVMint16 idx = ins->operands[0].lit_ui16;
        MVMint16 out = ins->operands[1].lit_ui16;
        MVMint16 via = ins->operands[2].reg.orig;
        MVMint16 src = ins->operands[3].reg.orig;
        MVMint16 i;
        MVMint32 via_off = WORK_OFF(via);
        MVMint32 src_off = WORK_OFF(src);
        MVMint32 env_off = idx * (MVMint32)sizeof(MVMRegister);
        | ldr TMP1, [x21, #via_off]
        | ldr TMP1, CODE:TMP1->body.outer
        for (i = 1; i < out; i++)
            | ldr TMP1, FRAME:TMP1->outer
        /* NB: the DynASM form `FRAME:TMP1->env` silently emits no
         * instruction here, so load env via an explicit offsetof. */
        | ldr TMP2, [TMP1, #offsetof(MVMFrame, env)]
        | ldr TMP3, [x21, #src_off]
        | str TMP3, [TMP2, #env_off]
        if (op == MVM_OP_sp_bindlexvia_os) {
            | check_wb TMP1, TMP3, >2
            | hit_wb TMP1, TMP3
            |2:
        }
        break;
    }
    case MVM_OP_getlexrel: {
        MVMint16 dst  = ins->operands[0].reg.orig;
        MVMint16 ctx  = ins->operands[1].reg.orig;
        MVMint16 name = ins->operands[2].reg.orig;
        MVMint32 dst_off  = WORK_OFF(dst);
        MVMint32 ctx_off  = WORK_OFF(ctx);
        MVMint32 name_off = WORK_OFF(name);
        | ldr TMP5, [x21, #ctx_off]
        | cmp_repr_id TMP5, TMP6, MVM_REPR_ID_MVMContext
        | beq >1
        | test_type_object TMP5
        | beq >1
        | throw_adhoc "getlexrel needs a context"
        |1:
        | mov ARG1, x19
        | mov ARG2, TMP5
        | ldr ARG3, [x21, #name_off]
        | callp &MVM_context_lexical_lookup
        | str RV, [x21, #dst_off]
        break;
    }
    case MVM_OP_getlexreldyn: {
        MVMint16 dst  = ins->operands[0].reg.orig;
        MVMint16 ctx  = ins->operands[1].reg.orig;
        MVMint16 name = ins->operands[2].reg.orig;
        MVMint32 dst_off  = WORK_OFF(dst);
        MVMint32 ctx_off  = WORK_OFF(ctx);
        MVMint32 name_off = WORK_OFF(name);
        | ldr TMP5, [x21, #ctx_off]
        | cmp_repr_id TMP5, TMP6, MVM_REPR_ID_MVMContext
        | beq >1
        | test_type_object TMP5
        | beq >1
        | throw_adhoc "getlexreldyn needs a context"
        |1:
        | mov ARG1, x19
        | mov ARG2, TMP5
        | ldr ARG3, [x21, #name_off]
        | callp &MVM_context_dynamic_lookup
        | str RV, [x21, #dst_off]
        break;
    }
    case MVM_OP_getlexrelcaller: {
        MVMint16 dst  = ins->operands[0].reg.orig;
        MVMint16 ctx  = ins->operands[1].reg.orig;
        MVMint16 name = ins->operands[2].reg.orig;
        MVMint32 dst_off  = WORK_OFF(dst);
        MVMint32 ctx_off  = WORK_OFF(ctx);
        MVMint32 name_off = WORK_OFF(name);
        | ldr TMP5, [x21, #ctx_off]
        | cmp_repr_id TMP5, TMP6, MVM_REPR_ID_MVMContext
        | beq >1
        | test_type_object TMP5
        | beq >1
        | throw_adhoc "getlexrelcaller needs a context"
        |1:
        | mov ARG1, x19
        | mov ARG2, TMP5
        | ldr ARG3, [x21, #name_off]
        | callp &MVM_context_caller_lookup
        | str RV, [x21, #dst_off]
        break;
    }
    case MVM_OP_getlex_no:
    case MVM_OP_sp_getlex_no: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMuint32 idx = ins->operands[1].lit_str_idx;
        MVMint32 dst_off = WORK_OFF(dst);
        | mov ARG1, x19
        | get_string ARG2, idx
        | mov ARG3, #MVM_reg_obj
        | callp &MVM_frame_find_lexical_by_name
        | cbz RV, >1
        | ldr RV, [RV]
        | str RV, [x21, #dst_off]
        | b >2
        |1:
        | get_vmnull TMP3
        | str TMP3, [x21, #dst_off]
        |2:
        break;
    }
    case MVM_OP_bindlex:
    case MVM_OP_sp_bindlex_os:
    case MVM_OP_sp_bindlex_in: {
        MVMuint16 *lexical_types;
        MVMStaticFrame *sf = jg->sg->sf;
        MVMint16 idx = ins->operands[0].lex.idx;
        MVMint16 out = ins->operands[0].lex.outers;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint16 i;
        MVMint32 src_off = WORK_OFF(src);
        MVMint32 env_off = idx * (MVMint32)sizeof(MVMRegister);
        | ldr TMP1, TC->cur_frame
        for (i = 0; i < out; i++) {
            | ldr TMP1, FRAME:TMP1->outer
            sf = sf->body.outer;
        }
        lexical_types = (!out && jg->sg->lexical_types ?
                         jg->sg->lexical_types :
                         sf->body.lexical_types);
        /* NB: the DynASM form `FRAME:TMP1->env` silently emits no
         * instruction here, so load env via an explicit offsetof. */
        | ldr TMP2, [TMP1, #offsetof(MVMFrame, env)]
        | ldr TMP3, [x21, #src_off]
        | str TMP3, [TMP2, #env_off]
        if (lexical_types[idx] == MVM_reg_obj || lexical_types[idx] == MVM_reg_str) {
            | check_wb TMP1, TMP3, >2
            | hit_wb TMP1, TMP3
            |2:
        }
        break;
    }
    case MVM_OP_lexprimspec: {
        MVMint16 dst  = ins->operands[0].reg.orig;
        MVMint16 ctx  = ins->operands[1].reg.orig;
        MVMint16 name = ins->operands[2].reg.orig;
        MVMint32 dst_off  = WORK_OFF(dst);
        MVMint32 ctx_off  = WORK_OFF(ctx);
        MVMint32 name_off = WORK_OFF(name);
        | ldr TMP1, [x21, #ctx_off]
        | cmp_repr_id TMP1, TMP2, MVM_REPR_ID_MVMContext
        | bne >1
        | test_type_object TMP1
        | bne >2
        |1:
        | throw_adhoc "lexprimspec needs a context"
        |2:
        | ldr ARG2, CONTEXT:TMP1->body.context
        | ldr ARG3, [x21, #name_off]
        | mov ARG1, x19
        | callp &MVM_frame_lexical_primspec
        | str RV, [x21, #dst_off]
        break;
    }
    case MVM_OP_sp_getarg_o:
    case MVM_OP_sp_getarg_n:
    case MVM_OP_sp_getarg_s:
    case MVM_OP_sp_getarg_u:
    case MVM_OP_sp_getarg_i: {
        MVMint32 reg = ins->operands[0].reg.orig;
        MVMuint16 idx = ins->operands[1].callsite_idx;
        MVMint32 dst_off = WORK_OFF(reg);
        MVMint32 map_off = (MVMint32)(idx * sizeof(MVMuint16));
        | ldr TMP1, TC->cur_frame
        | ldr TMP2, FRAME:TMP1->params.arg_info.map
        | ldrh w10, [TMP2, #map_off]
        | ldr TMP1, FRAME:TMP1->params.arg_info.source
        | ldr TMP1, [TMP1, TMP2, lsl #3]
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_sp_p6oget_i:
    case MVM_OP_sp_p6oget_u:
    case MVM_OP_sp_p6oget_i32:
    case MVM_OP_sp_p6oget_u32:
    case MVM_OP_sp_p6oget_n:
    case MVM_OP_sp_p6oget_s:
    case MVM_OP_sp_p6oget_bi:
    case MVM_OP_sp_p6oget_o:
    case MVM_OP_sp_p6ogetvc_o:
    case MVM_OP_sp_p6ogetvt_o:
    case MVM_OP_sp_getvc_o:
    case MVM_OP_sp_getvt_o: {
        MVMint16 dst    = ins->operands[0].reg.orig;
        MVMint16 obj    = ins->operands[1].reg.orig;
        MVMint32 body   = (MVMint32)offsetof(MVMP6opaque, body);
        MVMint16 offset = ins->operands[2].lit_i16;
        MVMint32 obj_off = WORK_OFF(obj);
        MVMint32 dst_off = WORK_OFF(dst);
        | ldr TMP1, [x21, #obj_off]
        if (op == MVM_OP_sp_getvc_o || op == MVM_OP_sp_getvt_o) {
            /* address = object + offset (no body indirection) */
            | add TMP2, TMP1, #offset
        } else {
            /* address = object->body + offset, or replaced->offset */
            MVMint32 base_off = body + offset;
            | add TMP2, TMP1, #base_off
            | ldr TMP4, P6OPAQUE:TMP1->body.replaced
            | cbz TMP4, >1
            | add TMP2, TMP4, #offset
            |1:
        }
        if (op == MVM_OP_sp_p6oget_o) {
            | ldr TMP3, [TMP2]
            | cbnz TMP3, >3
            | get_vmnull TMP3
            |3:
        } else if (op == MVM_OP_sp_p6ogetvt_o || op == MVM_OP_sp_getvt_o) {
            MVMint16 spesh_idx = ins->operands[3].lit_i16;
            MVMCollectable *spesh_value = jg->sg->spesh_slots[spesh_idx];
            | ldr TMP3, [TMP2]
            | cbnz TMP3, >4
            | get_spesh_slot TMP3, spesh_idx
            if (!(spesh_value->flags2 & MVM_CF_SECOND_GEN)) {
                | check_wb TMP1, TMP3, >3
                /* spill TMP2 and TMP3 around write barrier call */
                | stp TMP2, TMP3, [sp, #48]
                | mov ARG1, x19
                | ldr ARG2, [x21, #obj_off]
                | mov ARG3, TMP3
                | callp &MVM_gc_write_barrier_hit_by
                | ldp TMP2, TMP3, [sp, #48]
                |3:
            }
            | str TMP3, [TMP2]
            |4:
        } else if (op == MVM_OP_sp_p6ogetvc_o || op == MVM_OP_sp_getvc_o) {
            MVMint16 spesh_idx = ins->operands[3].lit_i16;
            | ldr TMP3, [TMP2]
            | cbnz TMP3, >4
            | mov ARG1, x19
            | get_spesh_slot ARG2, spesh_idx
            | callp &MVM_repr_clone
            | mov TMP3, RV
            /* reload object and recompute address after callp */
            | ldr TMP1, [x21, #obj_off]
            if (op == MVM_OP_sp_getvc_o) {
                | add TMP2, TMP1, #offset
            } else {
                MVMint32 base_off = body + offset;
                | add TMP2, TMP1, #base_off
                | ldr TMP4, P6OPAQUE:TMP1->body.replaced
                | cbz TMP4, >5
                | add TMP2, TMP4, #offset
                |5:
            }
            | check_wb TMP1, TMP3, >3
            | stp TMP2, TMP3, [sp, #48]
            | mov ARG1, x19
            | ldr ARG2, [x21, #obj_off]
            | mov ARG3, TMP3
            | callp &MVM_gc_write_barrier_hit_by
            | ldp TMP2, TMP3, [sp, #48]
            |3:
            | str TMP3, [TMP2]
            |4:
        } else if (op == MVM_OP_sp_p6oget_bi) {
            /* big integer body */
            | ldr w9, BIGINTBODY:TMP2->u.smallint.flag
            | cmp w9, #MVM_BIGINT_32_FLAG
            | bne >5
            | ldrsw TMP3, BIGINTBODY:TMP2->u.smallint.value
            | b >6
            |5:
            | mov ARG1, x19
            | mov ARG2, TMP2
            | callp &MVM_p6bigint_get_int64
            | mov TMP3, RV
            |6:
        } else if (op == MVM_OP_sp_p6oget_i32) {
            | ldrsw TMP3, [TMP2]
        } else if (op == MVM_OP_sp_p6oget_u32) {
            | ldr w11, [TMP2]
        } else {
            | ldr TMP3, [TMP2]
        }
        | str TMP3, [x21, #dst_off]
        break;
    }
    case MVM_OP_sp_bind_i64:
    case MVM_OP_sp_bind_u64:
    case MVM_OP_sp_bind_i32:
    case MVM_OP_sp_bind_u32:
    case MVM_OP_sp_bind_n:
    case MVM_OP_sp_bind_s:
    case MVM_OP_sp_bind_s_nowb:
    case MVM_OP_sp_bind_o: {
        MVMint16 obj    = ins->operands[0].reg.orig;
        MVMint16 offset = ins->operands[1].lit_i16;
        MVMint16 val    = ins->operands[2].reg.orig;
        MVMint32 obj_off = WORK_OFF(obj);
        MVMint32 val_off = WORK_OFF(val);
        | ldr TMP1, [x21, #obj_off]
        | ldr TMP2, [x21, #val_off]
        if (op == MVM_OP_sp_bind_o || op == MVM_OP_sp_bind_s) {
            | check_wb TMP1, TMP2, >2
            | hit_wb TMP1, TMP2
            | ldr TMP1, [x21, #obj_off]
            | ldr TMP2, [x21, #val_off]
            |2:
        }
        if (op == MVM_OP_sp_bind_i32 || op == MVM_OP_sp_bind_u32) {
            | str w10, [TMP1, #offset]
        } else {
            | str TMP2, [TMP1, #offset]
        }
        break;
    }
    case MVM_OP_sp_get_i64:
    case MVM_OP_sp_get_u64:
    case MVM_OP_sp_get_n:
    case MVM_OP_sp_get_s: {
        MVMint16 dst    = ins->operands[0].reg.orig;
        MVMint16 obj    = ins->operands[1].reg.orig;
        MVMint16 offset = ins->operands[2].lit_i16;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 obj_off = WORK_OFF(obj);
        | ldr TMP1, [x21, #obj_off]
        | ldr TMP2, [TMP1, #offset]
        | str TMP2, [x21, #dst_off]
        break;
    }
    case MVM_OP_sp_get_o: {
        MVMint16 dst    = ins->operands[0].reg.orig;
        MVMint16 obj    = ins->operands[1].reg.orig;
        MVMint16 offset = ins->operands[2].lit_i16;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 obj_off = WORK_OFF(obj);
        | ldr TMP1, [x21, #obj_off]
        | ldr TMP2, [TMP1, #offset]
        | cbnz TMP2, >1
        | get_vmnull TMP2
        |1:
        | str TMP2, [x21, #dst_off]
        break;
    }
    case MVM_OP_sp_get_u32:
    case MVM_OP_sp_get_i32: {
        MVMint16 dst    = ins->operands[0].reg.orig;
        MVMint16 obj    = ins->operands[1].reg.orig;
        MVMint16 offset = ins->operands[2].lit_i16;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 obj_off = WORK_OFF(obj);
        | ldr TMP1, [x21, #obj_off]
        if (op == MVM_OP_sp_get_i32) {
            | ldrsw TMP2, [TMP1, #offset]
        } else {
            | ldr w10, [TMP1, #offset]
        }
        | str TMP2, [x21, #dst_off]
        break;
    }
    case MVM_OP_sp_deref_bind_i64:
    case MVM_OP_sp_deref_bind_n: {
        MVMint16 obj    = ins->operands[0].reg.orig;
        MVMint16 val    = ins->operands[1].reg.orig;
        MVMint16 offset = ins->operands[2].lit_i16;
        MVMint32 obj_off = WORK_OFF(obj);
        MVMint32 val_off = WORK_OFF(val);
        | ldr TMP1, [x21, #obj_off]
        | ldr TMP2, [x21, #val_off]
        | ldr TMP1, [TMP1, #offset]
        | str TMP2, [TMP1]
        break;
    }
    case MVM_OP_sp_deref_get_i64:
    case MVM_OP_sp_deref_get_n: {
        MVMint16 dst    = ins->operands[0].reg.orig;
        MVMint16 obj    = ins->operands[1].reg.orig;
        MVMint16 offset = ins->operands[2].lit_i16;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 obj_off = WORK_OFF(obj);
        | ldr TMP1, [x21, #obj_off]
        | ldr TMP3, [TMP1, #offset]
        | ldr TMP2, [TMP3]
        | str TMP2, [x21, #dst_off]
        break;
    }
    case MVM_OP_sp_p6obind_i:
    case MVM_OP_sp_p6obind_u:
    case MVM_OP_sp_p6obind_i32:
    case MVM_OP_sp_p6obind_u32:
    case MVM_OP_sp_p6obind_n:
    case MVM_OP_sp_p6obind_s:
    case MVM_OP_sp_p6obind_o: {
        MVMint16 obj    = ins->operands[0].reg.orig;
        MVMint16 offset = ins->operands[1].lit_i16;
        MVMint16 val    = ins->operands[2].reg.orig;
        MVMint32 obj_off = WORK_OFF(obj);
        MVMint32 val_off = WORK_OFF(val);
        | ldr TMP1, [x21, #obj_off]
        | ldr TMP2, [x21, #val_off]
        /* compute body address, handling replaced */
        | add TMP3, TMP1, #offsetof(MVMP6opaque, body)
        | ldr TMP4, P6OBODY:TMP3->replaced
        | cbz TMP4, >1
        | mov TMP3, TMP4
        |1:
        if (op == MVM_OP_sp_p6obind_o || op == MVM_OP_sp_p6obind_s) {
            | check_wb TMP1, TMP2, >2
            /* spill TMP2 and TMP3 around write barrier */
            | stp TMP2, TMP3, [sp, #48]
            | mov ARG1, x19
            | ldr ARG2, [x21, #obj_off]
            | ldr ARG3, [x21, #val_off]
            | callp &MVM_gc_write_barrier_hit_by
            | ldp TMP2, TMP3, [sp, #48]
            |2:
        }
        if (op == MVM_OP_sp_p6obind_i32 || op == MVM_OP_sp_p6obind_u32) {
            | str w10, [TMP3, #offset]
        } else {
            | str TMP2, [TMP3, #offset]
        }
        break;
    }
    case MVM_OP_getwhere:
    case MVM_OP_set: {
        MVMint32 reg1 = ins->operands[0].reg.orig;
        MVMint32 reg2 = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(reg1);
        MVMint32 src_off = WORK_OFF(reg2);
        | ldr TMP1, [x21, #src_off]
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_sp_getspeshslot: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 spesh_idx = ins->operands[1].lit_i16;
        MVMint32 dst_off = WORK_OFF(dst);
        | get_spesh_slot TMP1, spesh_idx
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_ctx: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        | mov ARG1, x19
        | ldr ARG2, TC->cur_frame
        | callp &MVM_context_from_frame
        | str RV, [x21, #dst_off]
        break;
    }
    case MVM_OP_ctxlexpad: {
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint32 src_off = WORK_OFF(src);
        MVMint32 dst_off = WORK_OFF(dst);
        | ldr TMP1, [x21, #src_off]
        | test_type_object TMP1
        | bne >1
        | cmp_repr_id TMP1, TMP2, MVM_REPR_ID_MVMContext
        | beq >2
        |1:
        | throw_adhoc "ctxlexpad needs an MVMContext"
        |2:
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_ctxcallerskipthunks: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 ctx = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 ctx_off = WORK_OFF(ctx);
        | mov RV, xzr
        | ldr TMP5, [x21, #ctx_off]
        | test_type_object TMP5
        | bne >1
        | cmp_repr_id TMP5, TMP6, MVM_REPR_ID_MVMContext
        | bne >1
        | mov ARG1, x19
        | mov ARG2, TMP5
        | mov ARG3, #MVM_CTX_TRAV_CALLER_SKIP_THUNKS
        | callp &MVM_context_apply_traversal
        | str RV, [x21, #dst_off]
        | b >2
        |1:
        | throw_adhoc "ctxcallerskipthunks needs an MVMContext"
        |2:
        break;
    }
    case MVM_OP_curcode: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        | ldr TMP1, TC->cur_frame
        | ldr TMP1, FRAME:TMP1->code_ref
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_getcode: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMuint16 idx = ins->operands[1].coderef_idx;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 idx_off = (MVMint32)(idx * sizeof(MVMObject*));
        | ldr TMP1, CU->body.coderefs
        | ldr TMP1, [TMP1, #idx_off]
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_hllboxtype_n:
    case MVM_OP_hllboxtype_s:
    case MVM_OP_hllboxtype_i: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        | ldr TMP1, CU->body.hll_config
        if (op == MVM_OP_hllboxtype_n) {
            | ldr TMP1, HLLCONFIG:TMP1->num_box_type
        } else if (op == MVM_OP_hllboxtype_s) {
            | ldr TMP1, HLLCONFIG:TMP1->str_box_type
        } else {
            | ldr TMP1, HLLCONFIG:TMP1->int_box_type
        }
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_null_s: {
