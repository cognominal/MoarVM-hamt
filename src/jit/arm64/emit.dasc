        MVMint32 src_off = WORK_OFF(src);
        | ldr d0, [x21, #src_off]
        | fneg d0, d0
        | str d0, [x21, #dst_off]
        break;
    }
    case MVM_OP_eq_u:
    case MVM_OP_eq_i:
    case MVM_OP_eqaddr:
    case MVM_OP_ne_u:
    case MVM_OP_ne_i:
    case MVM_OP_lt_u:
    case MVM_OP_lt_i:
    case MVM_OP_le_u:
    case MVM_OP_le_i:
    case MVM_OP_gt_u:
    case MVM_OP_gt_i:
    case MVM_OP_ge_u:
    case MVM_OP_ge_i: {
        MVMint32 reg_a = ins->operands[0].reg.orig;
        MVMint32 reg_b = ins->operands[1].reg.orig;
        MVMint32 reg_c = ins->operands[2].reg.orig;
        MVMint32 a_off = WORK_OFF(reg_a);
        MVMint32 b_off = WORK_OFF(reg_b);
        MVMint32 c_off = WORK_OFF(reg_c);
        | ldr TMP1, [x21, #b_off]
        | ldr TMP2, [x21, #c_off]
        | cmp TMP1, TMP2
        switch (op) {
        case MVM_OP_eq_i: case MVM_OP_eq_u: case MVM_OP_eqaddr:
            | cset TMP3, eq
            break;
        case MVM_OP_ne_i: case MVM_OP_ne_u:
            | cset TMP3, ne
            break;
        case MVM_OP_lt_i:
            | cset TMP3, lt
            break;
        case MVM_OP_le_i:
            | cset TMP3, le
            break;
        case MVM_OP_gt_i:
            | cset TMP3, gt
            break;
        case MVM_OP_ge_i:
            | cset TMP3, ge
            break;
        case MVM_OP_lt_u:
            | cset TMP3, lo
            break;
        case MVM_OP_le_u:
            | cset TMP3, ls
            break;
        case MVM_OP_gt_u:
            | cset TMP3, hi
            break;
        case MVM_OP_ge_u:
            | cset TMP3, hs
            break;
        default:
            | cset TMP3, eq
            break;
        }
        | str TMP3, [x21, #a_off]
        break;
    }
    case MVM_OP_cmp_u:
    case MVM_OP_cmp_i: {
        MVMint32 reg_a = ins->operands[0].reg.orig;
        MVMint32 reg_b = ins->operands[1].reg.orig;
        MVMint32 reg_c = ins->operands[2].reg.orig;
        MVMint32 a_off = WORK_OFF(reg_a);
        MVMint32 b_off = WORK_OFF(reg_b);
        MVMint32 c_off = WORK_OFF(reg_c);
        | ldr TMP1, [x21, #b_off]
        | ldr TMP2, [x21, #c_off]
        if (op == MVM_OP_cmp_i) {
            | cmp TMP1, TMP2
            | cset TMP3, gt
            | cset TMP4, lt
        } else {
            | cmp TMP1, TMP2
            | cset TMP3, hi
            | cset TMP4, lo
        }
        | sub TMP3, TMP3, TMP4
        | str TMP3, [x21, #a_off]
        break;
    }
    case MVM_OP_gt_s:
    case MVM_OP_ge_s:
    case MVM_OP_lt_s:
    case MVM_OP_le_s: {
        MVMint32 reg = ins->operands[0].reg.orig;
        MVMint32 off = WORK_OFF(reg);
        | ldr TMP2, [x21, #off]
        switch (op) {
        case MVM_OP_gt_s:
            | cmp TMP2, #1
            | cset TMP1, eq
            break;
        case MVM_OP_lt_s:
            | cmn TMP2, #1
            | cset TMP1, eq
            break;
        case MVM_OP_ge_s:
            | cmp TMP2, #0
            | cset TMP1, ge
            break;
        case MVM_OP_le_s:
            | cmp TMP2, #0
            | cset TMP1, le
            break;
        }
        | str TMP1, [x21, #off]
        break;
    }
    case MVM_OP_not_i: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 src_off = WORK_OFF(src);
        | ldr TMP1, [x21, #src_off]
        | cmp TMP1, #0
        | cset TMP2, eq
        | str TMP2, [x21, #dst_off]
        break;
    }
    case MVM_OP_eq_n:
    case MVM_OP_ne_n:
    case MVM_OP_le_n:
    case MVM_OP_lt_n:
    case MVM_OP_ge_n:
    case MVM_OP_gt_n: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 a   = ins->operands[1].reg.orig;
        MVMint16 b   = ins->operands[2].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 a_off = WORK_OFF(a);
        MVMint32 b_off = WORK_OFF(b);
        | ldr d0, [x21, #a_off]
        | ldr d1, [x21, #b_off]
        switch (op) {
        case MVM_OP_eq_n:
            | fcmp d0, d1
            | cset TMP1, eq
            break;
        case MVM_OP_ne_n:
            | fcmp d0, d1
            | cset TMP1, ne
            break;
        case MVM_OP_lt_n:
            | fcmp d0, d1
            | cset TMP1, mi
            break;
        case MVM_OP_le_n:
            /* reversed: fcmp d1,d0 then GE */
            | fcmp d1, d0
            | cset TMP1, ge
            break;
        case MVM_OP_ge_n:
            | fcmp d0, d1
            | cset TMP1, ge
            break;
        case MVM_OP_gt_n:
            | fcmp d0, d1
            | cset TMP1, gt
            break;
        }
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_cmp_n: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 a   = ins->operands[1].reg.orig;
        MVMint16 b   = ins->operands[2].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 a_off = WORK_OFF(a);
        MVMint32 b_off = WORK_OFF(b);
        | ldr d0, [x21, #a_off]
        | ldr d1, [x21, #b_off]
        | fcmp d0, d1
        | cset TMP1, gt
        | cset TMP2, mi
        | sub TMP1, TMP1, TMP2
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_eq_I:
    case MVM_OP_ne_I:
    case MVM_OP_lt_I:
    case MVM_OP_le_I:
    case MVM_OP_gt_I:
    case MVM_OP_ge_I: {
        MVMint32 reg_a = ins->operands[0].reg.orig;
        MVMint32 reg_b = ins->operands[1].reg.orig;
        MVMint32 reg_c = ins->operands[2].reg.orig;
        MVMint32 a_off = WORK_OFF(reg_a);
        MVMint32 b_off = WORK_OFF(reg_b);
        MVMint32 c_off = WORK_OFF(reg_c);
        | mov ARG1, x19
        | ldr ARG2, [x21, #b_off]
        | ldr ARG3, [x21, #c_off]
        | callp &MVM_bigint_cmp
        switch (op) {
        case MVM_OP_eq_I:
            | cmp RV, #MP_EQ
            | cset RV, eq
            break;
        case MVM_OP_ne_I:
            | cmp RV, #MP_EQ
            | cset RV, ne
            break;
        case MVM_OP_lt_I:
            | cmp RV, #MP_LT
            | cset RV, eq
            break;
        case MVM_OP_le_I:
            | cmp RV, #MP_GT
            | cset RV, ne
            break;
        case MVM_OP_gt_I:
            | cmp RV, #MP_GT
            | cset RV, eq
            break;
        case MVM_OP_ge_I:
            | cmp RV, #MP_LT
            | cset RV, ne
            break;
        }
        | str RV, [x21, #a_off]
        break;
    }
    case MVM_OP_iscoderef:
    case MVM_OP_isint:
    case MVM_OP_isnum:
    case MVM_OP_isstr:
    case MVM_OP_islist:
    case MVM_OP_ishash: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 obj = ins->operands[1].reg.orig;
        MVMint32 reprid = op == MVM_OP_isint    ? MVM_REPR_ID_P6int   :
                          op == MVM_OP_isnum    ? MVM_REPR_ID_P6num   :
                          op == MVM_OP_isstr    ? MVM_REPR_ID_P6str   :
                          op == MVM_OP_islist   ? MVM_REPR_ID_VMArray :
                          op == MVM_OP_ishash   ? MVM_REPR_ID_MVMHash :
                       /* iscoderef: */ MVM_REPR_ID_MVMCode;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 obj_off = WORK_OFF(obj);
        | ldr TMP1, [x21, #obj_off]
        | cbz TMP1, >1
        | ldr TMP2, OBJECT:TMP1->st
        | ldr TMP2, STABLE:TMP2->REPR
        | ldr w17, REPR:TMP2->ID
        | cmp w17, #reprid
        | bne >1
        if (op == MVM_OP_iscoderef) {
            | test_type_object TMP1
            | bne >1
        }
        | mov TMP2, #1
        | str TMP2, [x21, #dst_off]
        | b >2
        |1:
        | str xzr, [x21, #dst_off]
        |2:
        break;
    }
    case MVM_OP_objprimspec: {
        MVMint16 dst  = ins->operands[0].reg.orig;
        MVMint16 type = ins->operands[1].reg.orig;
        MVMint32 dst_off  = WORK_OFF(dst);
        MVMint32 type_off = WORK_OFF(type);
        | ldr TMP6, [x21, #type_off]
        | cbz TMP6, >1
        | mov ARG1, x19
        | ldr ARG2, OBJECT:TMP6->st
        | ldr FUNCTION, STABLE:ARG2->REPR
        | ldr FUNCTION, REPR:FUNCTION->get_storage_spec
        | blr FUNCTION
        | ldrh w14, STORAGESPEC:RV->boxed_primitive
        |1:
        | str TMP6, [x21, #dst_off]
        break;
    }
    case MVM_OP_objprimbits: {
        MVMint16 dst  = ins->operands[0].reg.orig;
        MVMint16 type = ins->operands[1].reg.orig;
        MVMint32 dst_off  = WORK_OFF(dst);
        MVMint32 type_off = WORK_OFF(type);
        | ldr TMP6, [x21, #type_off]
        | cbz TMP6, >1
        | ldr ARG2, OBJECT:TMP6->st
        | ldr FUNCTION, STABLE:ARG2->REPR
        | ldr FUNCTION, REPR:FUNCTION->get_storage_spec
        | mov ARG1, x19
        | blr FUNCTION
        | ldrh w14, STORAGESPEC:RV->boxed_primitive
        | cbz TMP6, >1
        | ldrh w14, STORAGESPEC:RV->bits
        |1:
        | str TMP6, [x21, #dst_off]
        break;
    }
    case MVM_OP_objprimunsigned: {
        MVMint16 dst  = ins->operands[0].reg.orig;
        MVMint16 type = ins->operands[1].reg.orig;
        MVMint32 dst_off  = WORK_OFF(dst);
        MVMint32 type_off = WORK_OFF(type);
        | ldr TMP5, [x21, #type_off]
        | cbz TMP5, >1
        | mov ARG1, x19
        | ldr ARG2, OBJECT:TMP5->st
        | ldr FUNCTION, STABLE:ARG2->REPR
        | ldr FUNCTION, REPR:FUNCTION->get_storage_spec
        | blr FUNCTION
        | ldrh w14, STORAGESPEC:RV->boxed_primitive
        | cbz TMP6, >1
        | ldrb w14, STORAGESPEC:RV->is_unsigned
        | str TMP6, [x21, #dst_off]
        | b >2
        |1:
        | str xzr, [x21, #dst_off]
        |2:
        break;
    }
    case MVM_OP_isnonnull: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 obj = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 obj_off = WORK_OFF(obj);
        | ldr TMP1, [x21, #obj_off]
        | cmp TMP1, #0
        | cset TMP2, ne
        | get_vmnull TMP3
        | cmp TMP1, TMP3
        | cset TMP3, ne
        | and TMP2, TMP2, TMP3
        | str TMP2, [x21, #dst_off]
        break;
    }
    case MVM_OP_isnull: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 obj = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 obj_off = WORK_OFF(obj);
        | ldr TMP1, [x21, #obj_off]
        | cmp TMP1, #0
        | cset TMP2, eq
        | get_vmnull TMP3
        | cmp TMP1, TMP3
        | cset TMP3, eq
        | orr TMP2, TMP2, TMP3
        | str TMP2, [x21, #dst_off]
        break;
    }
    case MVM_OP_sp_fastcreate: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        arm64_emit_fastcreate(tc, compiler, jg, ins);
        | str RV, [x21, #dst_off]
        break;
    }
    case MVM_OP_decont:
    case MVM_OP_sp_decont: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 src_off = WORK_OFF(src);
        | ldr TMP5, [x21, #src_off]
        | test_type_object TMP5
        | bne >1
        | ldr TMP6, OBJECT:TMP5->st
        | ldr TMP6, STABLE:TMP6->container_spec
        | cbz TMP6, >1
        | mov ARG1, x19
        | mov ARG2, TMP5
        | add ARG3, x21, #dst_off
        | ldr FUNCTION, CONTAINERSPEC:TMP6->fetch
        | blr FUNCTION
        | b >2
        |1:
        | str TMP5, [x21, #dst_off]
        |2:
        break;
    }
    case MVM_OP_iscont: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 obj = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 obj_off = WORK_OFF(obj);
        | ldr TMP1, [x21, #obj_off]
        | cbz TMP1, >1
        | ldr TMP1, OBJECT:TMP1->st
        | ldr TMP1, STABLE:TMP1->container_spec
        |1:
        | cset TMP1, ne
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_isconcrete: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 obj = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 obj_off = WORK_OFF(obj);
        | ldr TMP1, [x21, #obj_off]
        | cbz TMP1, >1
        | test_type_object TMP1
        | bne >1
        | mov TMP2, #1
        | str TMP2, [x21, #dst_off]
        | b >2
        |1:
        | str xzr, [x21, #dst_off]
        |2:
        break;
    }
    case MVM_OP_markcodestatic: {
        MVMint16 cr = ins->operands[0].reg.orig;
        MVMint32 cr_off = WORK_OFF(cr);
        | ldr TMP1, [x21, #cr_off]
        | test_type_object TMP1
        | bne >1
        | cmp_repr_id TMP1, TMP2, MVM_REPR_ID_MVMCode
        | beq >2
        |1:
        | throw_adhoc "markcodestatic requires a concrete coderef"
        |2:
        | mov w10, #1
        | str w10, CODE:TMP1->body.is_static
        break;
    }
    case MVM_OP_markcodestub: {
        MVMint16 cr = ins->operands[0].reg.orig;
        MVMint32 cr_off = WORK_OFF(cr);
        | ldr TMP1, [x21, #cr_off]
        | test_type_object TMP1
        | bne >1
        | cmp_repr_id TMP1, TMP2, MVM_REPR_ID_MVMCode
        | beq >2
        |1:
        | throw_adhoc "markcodestub requires a concrete coderef"
        |2:
        | mov w10, #1
        | str w10, CODE:TMP1->body.is_compiler_stub
        break;
    }
    case MVM_OP_takehandlerresult: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        | ldr TMP1, TC->last_handler_result
        | cbnz TMP1, >1
        | get_vmnull TMP1
        |1:
        | str TMP1, [x21, #dst_off]
        | str xzr, TC->last_handler_result
        break;
    }
    case MVM_OP_exception: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        | ldr TMP1, TC->active_handlers
        | cbz TMP1, >1
        | ldr TMP1, MVMACTIVEHANDLERS:TMP1->ex_obj
        | str TMP1, [x21, #dst_off]
        | b >2
        |1:
        | get_vmnull TMP1
        | str TMP1, [x21, #dst_off]
        |2:
        break;
    }
    case MVM_OP_scwbdisable: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        | ldr w9, TC->sc_wb_disable_depth
        | add w9, w9, #1
        | str w9, TC->sc_wb_disable_depth
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_scwbenable: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        | ldr w9, TC->sc_wb_disable_depth
        | sub w9, w9, #1
        | str w9, TC->sc_wb_disable_depth
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_assign:
    case MVM_OP_assignunchecked: {
        MVMint16 cont = ins->operands[0].reg.orig;
        MVMint16 obj  = ins->operands[1].reg.orig;
        MVMint32 cont_off = WORK_OFF(cont);
        MVMint32 obj_off  = WORK_OFF(obj);
        | ldr ARG2, [x21, #cont_off]
        | ldr FUNCTION, OBJECT:ARG2->st
        | ldr FUNCTION, STABLE:FUNCTION->container_spec
        | cbnz FUNCTION, >1
        | throw_adhoc "Cannot assign to an immutable value"
        |1:
        | mov ARG1, x19
        | ldr ARG3, [x21, #obj_off]
        if (op == MVM_OP_assign) {
            | ldr FUNCTION, CONTAINERSPEC:FUNCTION->store
        } else {
            | ldr FUNCTION, CONTAINERSPEC:FUNCTION->store_unchecked
        }
        | blr FUNCTION
        break;
    }
    case MVM_OP_sp_getlexstatic_o: {
        MVMint16 dst       = ins->operands[0].reg.orig;
        MVMint16 name      = ins->operands[1].reg.orig;
        MVMint16 spesh_idx = ins->operands[2].lit_i16;
        MVMuint32 slot     = ins->operands[3].lit_ui32;
        MVMint32 dst_off  = WORK_OFF(dst);
        MVMint32 name_off = WORK_OFF(name);
        MVMint32 ic_off   = (MVMint32)offsetof(MVMStaticFrame, body.inline_cache);
        MVMint32 entry_off = (MVMint32)(slot * sizeof(MVMDispInlineCacheEntry));
        | mov ARG1, x19
        | get_spesh_slot ARG2, spesh_idx
        | add ARG2, ARG2, #ic_off
        | ldr ARG2, MVMDISPINLINECACHE:ARG2->entries
        | add ARG2, ARG2, #entry_off
        | ldr ARG3, [x21, #name_off]
        | ldr FUNCTION, [ARG2]
        | ldr FUNCTION, MVMDISPINLINECACHEENTRY:FUNCTION->run_getlexstatic
        | blr FUNCTION
        | str RV, [x21, #dst_off]
        break;
    }
    case MVM_OP_getlexperinvtype_o: {
        MVMint16 dst  = ins->operands[0].reg.orig;
        MVMint16 name = ins->operands[1].reg.orig;
        MVMint32 dst_off  = WORK_OFF(dst);
        MVMint32 name_off = WORK_OFF(name);
        | mov ARG1, x19
        | ldr ARG2, [x21, #name_off]
        | mov ARG3, #MVM_reg_obj
        | callp &MVM_frame_find_lexical_by_name
        | cbz RV, >1
        | ldr RV, [RV]
        |1:
        | str RV, [x21, #dst_off]
        break;
    }
    case MVM_OP_paramnamesused: {
        MVMint32 params_off = (MVMint32)offsetof(MVMFrame, params);
        | ldr TMP2, TC->cur_frame
        | add ARG2, TMP2, #params_off
        | ldr ARG3, ARGCTX:ARG2->arg_info.callsite
        | ldrh w9, CALLSITE:ARG3->num_pos
        | ldrh w10, CALLSITE:ARG3->flag_count
        | cmp w9, w10
        | beq >1
        | mov ARG1, x19
        | callp &MVM_args_assert_nameds_used
        |1:
        break;
    }
    case MVM_OP_sp_assertparamcheck: {
        MVMint16 ok        = ins->operands[0].reg.orig;
        MVMint16 spesh_idx = ins->operands[1].lit_i16;
        MVMuint32 slot     = ins->operands[2].lit_ui32;
        MVMint32 ok_off   = WORK_OFF(ok);
        MVMint32 ic_off   = (MVMint32)offsetof(MVMStaticFrame, body.inline_cache);
        MVMint32 entry_off = (MVMint32)(slot * sizeof(MVMDispInlineCacheEntry));
        | ldr TMP1, [x21, #ok_off]
        | cbnz TMP1, >1
        | mov ARG1, x19
        | get_spesh_slot ARG2, spesh_idx
        | add ARG2, ARG2, #ic_off
        | ldr ARG2, MVMDISPINLINECACHE:ARG2->entries
        | add ARG2, ARG2, #entry_off
        | callp &MVM_args_bind_failed
        |1:
        break;
    }
    case MVM_OP_prof_enterspesh:
        | mov ARG1, x19
        | ldr ARG2, TC->cur_frame
        | ldr ARG2, FRAME:ARG2->static_info
        | mov ARG3, #MVM_PROFILE_ENTER_JIT
        | callp &MVM_profile_log_enter
        break;
    case MVM_OP_prof_enterinline: {
        MVMint16 spesh_idx = ins->operands[0].lit_i16;
        | mov ARG1, x19
        | get_spesh_slot ARG2, spesh_idx
        | mov ARG3, #MVM_PROFILE_ENTER_JIT_INLINE
        | callp &MVM_profile_log_enter
        break;
    }
    case MVM_OP_prof_replaced: {
        MVMint16 spesh_idx = ins->operands[0].lit_i16;
        | mov ARG1, x19
        | get_spesh_slot ARG2, spesh_idx
        | callp &MVM_profile_log_scalar_replaced
        break;
    }
    case MVM_OP_getobjsc: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 obj = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 obj_off = WORK_OFF(obj);
        | ldr TMP1, [x21, #obj_off]
        | ldr w10, COLLECTABLE:TMP1->sc_forward_u.sc.sc_idx
        | mov TMP3, xzr
        | cmp w10, #0
        | ble >1
        | ldr TMP3, TC->instance
        | ldr TMP3, MVMINSTANCE:TMP3->all_scs
        | ldr TMP3, [TMP3, TMP2, lsl #3]
        | ldr TMP3, SCREFBODY:TMP3->sc
        |1:
        | str TMP3, [x21, #dst_off]
        break;
    }
    case MVM_OP_setobjsc: {
        MVMint16 obj = ins->operands[0].reg.orig;
        MVMint16 sc  = ins->operands[1].reg.orig;
        MVMint32 obj_off = WORK_OFF(obj);
        MVMint32 sc_off  = WORK_OFF(sc);
        | ldr TMP5, [x21, #sc_off]
        | cmp_repr_id TMP5, TMP6, MVM_REPR_ID_SCRef
        | beq >1
        | throw_adhoc "Must provide an SCRef operand to setobjsc"
        |1:
        | mov ARG1, x19
        | ldr ARG2, [x21, #obj_off]
        | mov ARG3, TMP5
        | callp &MVM_sc_set_obj_sc
        break;
    }
    case MVM_OP_scgethandle:
    case MVM_OP_scobjcount: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 sc  = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 sc_off  = WORK_OFF(sc);
        | ldr TMP5, [x21, #sc_off]
        | cmp_repr_id TMP5, TMP6, MVM_REPR_ID_SCRef
        | beq >1
        if (op == MVM_OP_scgethandle) {
            | throw_adhoc "Must provide an SCRef operand to scgethandle"
        } else {
            | throw_adhoc "Must provide an SCRef operand to scobjcount"
        }
        |1:
        | mov ARG1, x19
        | mov ARG2, TMP5
        if (op == MVM_OP_scgethandle) {
            | callp &MVM_sc_get_handle
        } else {
            | callp &MVM_sc_get_object_count
        }
        | str RV, [x21, #dst_off]
        break;
    }
    case MVM_OP_getstdin:
    case MVM_OP_getstdout:
    case MVM_OP_getstderr: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        | ldr TMP3, TC->instance
        if (op == MVM_OP_getstdin) {
            | ldr TMP3, MVMINSTANCE:TMP3->stdin_handle
        } else if (op == MVM_OP_getstdout) {
            | ldr TMP3, MVMINSTANCE:TMP3->stdout_handle
        } else {
            | ldr TMP3, MVMINSTANCE:TMP3->stderr_handle
        }
        | str TMP3, [x21, #dst_off]
        break;
    }
    case MVM_OP_ordat:
    case MVM_OP_ordbaseat:
    case MVM_OP_ordfirst: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 str = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 str_off = WORK_OFF(str);
        | mov ARG1, x19
        | ldr ARG2, [x21, #str_off]
        if (op == MVM_OP_ordat || op == MVM_OP_ordbaseat) {
            MVMint16 idx = ins->operands[2].reg.orig;
            MVMint32 idx_off = WORK_OFF(idx);
            | ldr ARG3, [x21, #idx_off]
        } else {
            | mov ARG3, #0
        }
        if (op == MVM_OP_ordbaseat) {
            | callp &MVM_string_ord_basechar_at
        } else {
            | callp &MVM_string_ord_at
        }
        | sxtw RV, w0
        | str RV, [x21, #dst_off]
        break;
    }
    case MVM_OP_getcodename: {
        MVMint16 obj  = ins->operands[0].reg.orig;
        MVMint16 code = ins->operands[1].reg.orig;
        MVMint32 obj_off  = WORK_OFF(obj);
        MVMint32 code_off = WORK_OFF(code);
        | ldr TMP1, [x21, #code_off]
        | cmp_repr_id TMP1, TMP2, MVM_REPR_ID_MVMCode
        | bne >1
        | test_type_object TMP1
        | beq >2
        |1:
        | throw_adhoc "getcodename requires a concrete object"
        |2:
        | ldr TMP2, CODE:TMP1->body.name
        | str TMP2, [x21, #obj_off]
        break;
    }
    case MVM_OP_setcodeobj: {
        MVMint16 obj  = ins->operands[0].reg.orig;
        MVMint16 code = ins->operands[1].reg.orig;
        MVMint32 obj_off  = WORK_OFF(obj);
        MVMint32 code_off = WORK_OFF(code);
        | ldr TMP1, [x21, #obj_off]
        | cmp_repr_id TMP1, TMP2, MVM_REPR_ID_MVMCode
        | beq >1
        | throw_adhoc "setcodeobj needs a code ref"
        |1:
        | ldr TMP2, [x21, #code_off]
        | str TMP2, CODE:TMP1->body.code_object
        | check_wb TMP1, TMP2, >2
        | hit_wb TMP1, TMP2
        |2:
        break;
    }
    case MVM_OP_setcodename: {
        MVMint16 obj  = ins->operands[0].reg.orig;
        MVMint16 code = ins->operands[1].reg.orig;
        MVMint32 obj_off  = WORK_OFF(obj);
        MVMint32 code_off = WORK_OFF(code);
        | ldr TMP1, [x21, #obj_off]
        | cmp_repr_id TMP1, TMP2, MVM_REPR_ID_MVMCode
        | beq >1
        | throw_adhoc "setcodename needs a code ref"
        |1:
        | ldr TMP2, [x21, #code_off]
        | str TMP2, CODE:TMP1->body.name
        | check_wb TMP1, TMP2, >2
        | hit_wb TMP1, TMP2
        |2:
        break;
    }
    case MVM_OP_lastexpayload: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        | ldr TMP3, TC->last_payload
        | str TMP3, [x21, #dst_off]
        break;
    }
    case MVM_OP_param_sp: {
        MVMuint16 dst = ins->operands[0].reg.orig;
        MVMuint16 off = ins->operands[1].lit_ui16;
        MVMint32 dst_off = WORK_OFF(dst);
        | mov ARG1, x19
        | mov ARG2, #0
        | mov ARG3, #off
        | callp &MVM_args_slurpy_positional
        | str RV, [x21, #dst_off]
        break;
    }
    case MVM_OP_param_sn: {
        MVMuint16 dst = ins->operands[0].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        | mov ARG1, x19
        | mov ARG2, #0
        | callp &MVM_args_slurpy_named
        | str RV, [x21, #dst_off]
        break;
    }
    case MVM_OP_sp_bindcomplete: {
        MVMint16 spesh_idx = ins->operands[0].lit_i16;
        MVMuint32 slot     = ins->operands[1].lit_ui32;
        MVMint32 ic_off   = (MVMint32)offsetof(MVMStaticFrame, body.inline_cache);
        MVMint32 entry_off = (MVMint32)(slot * sizeof(MVMDispInlineCacheEntry));
        | mov ARG1, x19
        | get_spesh_slot ARG2, spesh_idx
        | add ARG2, ARG2, #ic_off
        | ldr ARG2, MVMDISPINLINECACHE:ARG2->entries
        | add ARG2, ARG2, #entry_off
        | callp &MVM_args_bind_succeeded
        break;
    }
    case MVM_OP_sp_cas_o: {
        MVMint16 target   = ins->operands[1].reg.orig;
        MVMint16 expected = ins->operands[2].reg.orig;
        MVMint16 value    = ins->operands[3].reg.orig;
        MVMint16 result   = ins->operands[0].reg.orig;
        MVMint32 target_off   = WORK_OFF(target);
        MVMint32 expected_off = WORK_OFF(expected);
        MVMint32 value_off    = WORK_OFF(value);
        MVMint32 result_off   = WORK_OFF(result);
        | mov ARG1, x19
        | ldr ARG2, [x21, #target_off]
        | ldr ARG3, [x21, #expected_off]
        | ldr ARG4, [x21, #value_off]
        | add ARG5, x21, #result_off
        | ldr FUNCTION, OBJECT:ARG2->st
        | ldr FUNCTION, STABLE:FUNCTION->container_spec
        | ldr FUNCTION, CONTAINERSPEC:FUNCTION->cas
        | blr FUNCTION
        break;
    }
    case MVM_OP_sp_atomicload_o: {
        MVMint16 target = ins->operands[1].reg.orig;
        MVMint16 result = ins->operands[0].reg.orig;
        MVMint32 target_off = WORK_OFF(target);
        MVMint32 result_off = WORK_OFF(result);
        | mov ARG1, x19
        | ldr ARG2, [x21, #target_off]
        | ldr FUNCTION, OBJECT:ARG2->st
        | ldr FUNCTION, STABLE:FUNCTION->container_spec
        | ldr FUNCTION, CONTAINERSPEC:FUNCTION->load_atomic
        | blr FUNCTION
        | str RV, [x21, #result_off]
        break;
    }
    case MVM_OP_sp_atomicstore_o: {
        MVMint16 target = ins->operands[0].reg.orig;
        MVMint16 value  = ins->operands[1].reg.orig;
        MVMint32 target_off = WORK_OFF(target);
        MVMint32 value_off  = WORK_OFF(value);
        | mov ARG1, x19
        | ldr ARG2, [x21, #target_off]
        | ldr ARG3, [x21, #value_off]
        | ldr FUNCTION, OBJECT:ARG2->st
        | ldr FUNCTION, STABLE:FUNCTION->container_spec
        | ldr FUNCTION, CONTAINERSPEC:FUNCTION->store_atomic
        | blr FUNCTION
        break;
    }
    case MVM_OP_hllbool: {
        MVMint16 target = ins->operands[0].reg.orig;
        MVMint16 value  = ins->operands[1].reg.orig;
        MVMHLLConfig *hll_config = (MVMHLLConfig*)jg->sg->sf->body.cu->body.hll_config;
        MVMint32 target_off = WORK_OFF(target);
        MVMint32 value_off  = WORK_OFF(value);
        | ldr TMP1, [x21, #value_off]
        | cbnz TMP1, >1
        arm64_mov64_tmp1(tc, compiler, (MVMuint64)(uintptr_t)hll_config->false_value);
        | b >2
        |1:
        arm64_mov64_tmp1(tc, compiler, (MVMuint64)(uintptr_t)hll_config->true_value);
        |2:
        | str TMP1, [x21, #target_off]
        break;
    }
    case MVM_OP_hllboolfor: {
        MVMint16 target = ins->operands[0].reg.orig;
        MVMint16 value  = ins->operands[1].reg.orig;
        MVMHLLConfig *hll_config = (MVMHLLConfig*)(uintptr_t)ins->operands[2].lit_i64;
        MVMint32 target_off = WORK_OFF(target);
        MVMint32 value_off  = WORK_OFF(value);
        | ldr TMP1, [x21, #value_off]
        | cbnz TMP1, >1
        arm64_mov64_tmp1(tc, compiler, (MVMuint64)(uintptr_t)hll_config->false_value);
        | b >2
        |1:
        arm64_mov64_tmp1(tc, compiler, (MVMuint64)(uintptr_t)hll_config->true_value);
        |2:
        | str TMP1, [x21, #target_off]
        break;
    }
    case MVM_OP_newtype: {
        MVMint16 dst  = ins->operands[0].reg.orig;
        MVMint16 how  = ins->operands[1].reg.orig;
        MVMint16 name = ins->operands[2].reg.orig;
        MVMint32 dst_off  = WORK_OFF(dst);
        MVMint32 how_off  = WORK_OFF(how);
        MVMint32 name_off = WORK_OFF(name);
        | mov ARG1, x19
        | ldr ARG2, [x21, #name_off]
        | callp &MVM_repr_get_by_name
        | ldr FUNCTION, REPR:RV->type_object_for
        | mov ARG1, x19
        | ldr ARG2, [x21, #how_off]
        | blr FUNCTION
        | str RV, [x21, #dst_off]
        break;
    }
    case MVM_OP_newmixintype: {
        MVMint16 dst  = ins->operands[0].reg.orig;
        MVMint16 how  = ins->operands[1].reg.orig;
        MVMint16 name = ins->operands[2].reg.orig;
        MVMint32 dst_off  = WORK_OFF(dst);
        MVMint32 how_off  = WORK_OFF(how);
        MVMint32 name_off = WORK_OFF(name);
        | mov ARG1, x19
        | ldr ARG2, [x21, #name_off]
        | callp &MVM_repr_get_by_name
        | ldr FUNCTION, REPR:RV->type_object_for
        | mov ARG1, x19
        | ldr ARG2, [x21, #how_off]
        | blr FUNCTION
        | ldr TMP1, OBJECT:RV->st
        | mov w10, #1
        | str w10, STABLE:TMP1->is_mixin_type
        | str RV, [x21, #dst_off]
        break;
    }
    case MVM_OP_composetype: {
        MVMint16 dst  = ins->operands[0].reg.orig;
        MVMint16 obj  = ins->operands[1].reg.orig;
        MVMint16 type = ins->operands[2].reg.orig;
        MVMint32 dst_off  = WORK_OFF(dst);
        MVMint32 obj_off  = WORK_OFF(obj);
        MVMint32 type_off = WORK_OFF(type);
        | ldr TMP6, [x21, #obj_off]
        | ldr FUNCTION, OBJECT:TMP6->st
        | ldr FUNCTION, STABLE:FUNCTION->REPR
        | ldr FUNCTION, REPR:FUNCTION->compose
        | mov ARG1, x19
        | get_stable ARG2, TMP6
        | ldr ARG3, [x21, #type_off]
        | blr FUNCTION
        | ldr TMP1, [x21, #obj_off]
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_sp_fastbox_i:
    case MVM_OP_sp_fastbox_u:
    case MVM_OP_sp_fastbox_i_ic:
    case MVM_OP_sp_fastbox_u_ic: {
        MVMint32 use_cache = (op == MVM_OP_sp_fastbox_i_ic || op == MVM_OP_sp_fastbox_u_ic);
        MVMint16 dst    = ins->operands[0].reg.orig;
        MVMint16 offset = ins->operands[3].lit_i16;
        MVMint16 val    = ins->operands[4].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 val_off = WORK_OFF(val);
        if (use_cache) {
            MVMObject **cache = tc->instance->int_const_cache->cache[ins->operands[5].lit_i16];
            /* TMP2=x10 holds index (val+1), TMP1=x9 holds cache ptr */
            | ldr TMP2, [x21, #val_off]
            | cmp TMP2, #14
            | bgt >1
            | cmn TMP2, #1
            | blt >1
            | add TMP2, TMP2, #1
            arm64_mov64_tmp1(tc, compiler, (MVMuint64)(uintptr_t)cache);
            | ldr TMP1, [TMP1, TMP2, lsl #3]
            | str TMP1, [x21, #dst_off]
            | b >2
            |1:
        }
        arm64_emit_fastcreate(tc, compiler, jg, ins);
        | str RV, [x21, #dst_off]
        | ldr TMP3, [x21, #val_off]
        | str TMP3, [RV, #offset]
        if (use_cache)
            |2:
        break;
    }
    case MVM_OP_sp_fastbox_bi:
    case MVM_OP_sp_fastbox_bi_ic:
        MVM_oops(tc, "ARM64 JIT: sp_fastbox_bi not yet implemented");
        break;
    case MVM_OP_sp_add_I:
    case MVM_OP_sp_sub_I:
    case MVM_OP_sp_mul_I:
        MVM_oops(tc, "ARM64 JIT: bigint arithmetic ops not yet implemented");
        break;
    case MVM_OP_sp_bool_I:
        MVM_oops(tc, "ARM64 JIT: sp_bool_I not yet implemented");
        break;
    case MVM_OP_sp_boolify_iter_arr:
        MVM_oops(tc, "ARM64 JIT: sp_boolify_iter_arr not yet implemented");
        break;
    case MVM_OP_getcomp: {
        MVMint16 dst  = ins->operands[0].reg.orig;
        MVMint16 comp = ins->operands[1].reg.orig;
        MVMint32 dst_off  = WORK_OFF(dst);
        MVMint32 comp_off = WORK_OFF(comp);
        | ldr ARG1, TC->instance
        | add ARG1, ARG1, #offsetof(MVMInstance, mutex_compiler_registry)
        | callp &uv_mutex_lock
        | mov ARG1, x19
        | ldr ARG2, TC->instance
        | ldr ARG2, MVMINSTANCE:ARG2->compiler_registry
        | ldr ARG3, [x21, #comp_off]
        | callp &MVM_repr_at_key_o
        | str RV, [x21, #dst_off]
        | ldr ARG1, TC->instance
        | add ARG1, ARG1, #offsetof(MVMInstance, mutex_compiler_registry)
        | callp &uv_mutex_unlock
        break;
    }
    default:
        MVM_oops(tc, "ARM64 JIT: emit_primitive: unimplemented op '%s'", ins->info->name);
    }
}

void MVM_jit_emit_call_c(MVMThreadContext *tc, MVMJitCompiler *compiler,
                         MVMJitGraph *jg, MVMJitCallC *call_spec) {
    MVMint32 sp_adj = emit_arm64_callargs(tc, compiler, jg, call_spec->args, call_spec->num_args);
    if (sp_adj > 0) {
        /* sp was adjusted for stack args — use blr directly (callp would use
         * [sp,#40] which is no longer the trampoline slot).  call_c functions
         * don't dispatch MoarVM frames, so the trampoline isn't needed. */
        arm64_mov64_tmp1(tc, compiler, (MVMuint64)(uintptr_t)(call_spec->func_ptr));
        | mov FUNCTION, TMP1
        | blr FUNCTION
        | add sp, sp, #sp_adj
    } else {
        | callp call_spec->func_ptr
    }

    switch (call_spec->rv_mode) {
    case MVM_JIT_RV_VOID:
        break;
    case MVM_JIT_RV_INT:
    case MVM_JIT_RV_PTR: {
        MVMint32 offset = call_spec->rv_idx * (MVMint32)sizeof(MVMRegister);
        | str RV, [x21, #offset]
        break;
    }
    case MVM_JIT_RV_INT_NEGATED: {
        MVMint32 offset = call_spec->rv_idx * (MVMint32)sizeof(MVMRegister);
        | cmp RV, #0
        | cset TMP2, eq
        | str TMP2, [x21, #offset]
        break;
    }
    case MVM_JIT_RV_NUM: {
        MVMint32 offset = call_spec->rv_idx * (MVMint32)sizeof(MVMRegister);
        | str d0, [x21, #offset]
        break;
    }
    case MVM_JIT_RV_DEREF: {
        MVMint32 offset = call_spec->rv_idx * (MVMint32)sizeof(MVMRegister);
        | ldr TMP1, [RV]
        | str TMP1, [x21, #offset]
        break;
    }
    case MVM_JIT_RV_ADDR: {
        MVMint32 offset = call_spec->rv_idx * (MVMint32)sizeof(MVMRegister);
        | ldr TMP1, [x21, #offset]
        | str TMP1, [RV]
        break;
    }
    case MVM_JIT_RV_DYNIDX:
        /* cur_op holds a u16 reg index at position rv_idx */
        | get_cur_op TMP2
        | ldrh w10, [x10, #(call_spec->rv_idx * 2)]
        | str RV, [x21, x10, lsl #3]
        break;
    case MVM_JIT_RV_DEREF_OR_VMNULL: {
        MVMint32 offset = call_spec->rv_idx * (MVMint32)sizeof(MVMRegister);
        | cbz RV, >4
        | ldr TMP1, [RV]
        | b >5
        |4:
        | get_vmnull TMP1
        |5:
        | str TMP1, [x21, #offset]
        break;
    }
    case MVM_JIT_RV_TO_STACK:
        MVM_oops(tc, "ARM64 JIT: RV_TO_STACK not yet implemented");
        break;
    }
}

void MVM_jit_emit_conditional_branch(MVMThreadContext *tc, MVMJitCompiler *compiler,
                                     MVMint32 cond, MVMint32 label,
                                     MVMuint8 test_type) {
    MVMint32 is_float = (test_type == MVM_reg_num32 || test_type == MVM_reg_num64);
    /* ARM64 condition codes after CMP (integer) or FCMP (float).
     * For FCMP, NaN produces N=0 Z=0 C=1 V=1; most conditions naturally
     * exclude NaN except NE which includes it (matching x64 behaviour). */
    switch (cond) {
    case MVM_JIT_LT:
        if (is_float) {
            /* MI: N=1, which is false for NaN (N=0 after FCMP on NaN) */
            | bmi =>(label)
        } else {
            | blt =>(label)
        }
        break;
    case MVM_JIT_LE:
        if (is_float) {
            /* LS: C=0 or Z=1, false for NaN (C=1, Z=0) */
            | bls =>(label)
        } else {
            | ble =>(label)
        }
        break;
    case MVM_JIT_EQ:
        | beq =>(label)
        break;
    case MVM_JIT_NE:
        /* NE: Z=0; NaN also has Z=0 so NaN branches — same as x64 (jp | jne) */
        | bne =>(label)
        break;
    case MVM_JIT_GE:
        /* GE: N=V; for FCMP: NaN has N=0,V=1 so N!=V -> false. Safe. */
        | bge =>(label)
        break;
    case MVM_JIT_GT:
        /* GT: Z=0 and N=V; NaN: N!=V -> false. Safe. */
        | bgt =>(label)
        break;
    case MVM_JIT_NZ:
        /* NE: Z=0; NaN has Z=0 so branches (NaN is non-zero) */
        | bne =>(label)
        break;
    case MVM_JIT_ZR:
        /* EQ: Z=1; NaN has Z=0 so does NOT branch. Safe. */
        | beq =>(label)
        break;
    default:
        abort();
    }
}

void MVM_jit_emit_guard(MVMThreadContext *tc, MVMJitCompiler *compiler,
                        MVMJitGraph *jg, MVMJitGuard *guard) {
    MVMint16 op  = guard->ins->info->opcode;
    MVMint16 obj = guard->ins->operands[op == MVM_OP_sp_guardsf ? 0 : 1].reg.orig;
    MVMint32 obj_off = obj * (MVMint32)sizeof(MVMRegister);

    /* Load object into TMP1 */
    | ldr TMP1, [x21, #obj_off]

    /* Load spesh slot value into TMP2 (not needed for some ops) */
    if (op != MVM_OP_sp_guardjustconc && op != MVM_OP_sp_guardjusttype &&
            op != MVM_OP_sp_guardnonzero && op != MVM_OP_sp_guardhll &&
                op != MVM_OP_sp_rebless) {
        MVMint16 spesh_idx = guard->ins->operands[op == MVM_OP_sp_guardsf ? 1 : 2].lit_i16;
        | get_spesh_slot TMP2, spesh_idx
    }

    if (op == MVM_OP_sp_guard) {
        | cbz TMP1, >1
        | ldr TMP3, OBJECT:TMP1->st
        | cmp TMP2, TMP3
        | bne >1
    } else if (op == MVM_OP_sp_guardtype) {
        | cbz TMP1, >1
        | test_type_object TMP1
        | beq >1
        | ldr TMP3, OBJECT:TMP1->st
        | cmp TMP2, TMP3
        | bne >1
    } else if (op == MVM_OP_sp_guardconc) {
        | cbz TMP1, >1
        | test_type_object TMP1
        | bne >1
        | ldr TMP3, OBJECT:TMP1->st
        | cmp TMP2, TMP3
        | bne >1
    } else if (op == MVM_OP_sp_guardhll) {
        MVMuint64 hll_val = guard->ins->operands[2].lit_ui64;
        | .data
        | 6:
        | .quad hll_val
        | .code
        | ldr TMP2, <6
        | ldr TMP3, OBJECT:TMP1->st
        | ldr TMP4, STABLE:TMP3->hll_owner
        | cmp TMP2, TMP4
        | bne >1
    } else if (op == MVM_OP_sp_guardsf) {
        | ldr TMP3, CODE:TMP1->body.sf
        | cmp TMP2, TMP3
        | bne >1
    } else if (op == MVM_OP_sp_guardobj) {
        | cmp TMP2, TMP1
        | bne >1
    } else if (op == MVM_OP_sp_guardnonzero) {
        | cbz TMP1, >1
    } else if (op == MVM_OP_sp_guardnotobj) {
        | cmp TMP2, TMP1
        | beq >1
    } else if (op == MVM_OP_sp_guardjustconc) {
        | cbz TMP1, >1
        | test_type_object TMP1
        | bne >1
    } else if (op == MVM_OP_sp_guardjusttype) {
        | cbz TMP1, >1
        | test_type_object TMP1
        | beq >1
    } else if (op == MVM_OP_sp_rebless) {
        MVM_oops(tc, "ARM64 JIT: sp_rebless guard not yet implemented");
    }

    /* Guard passed: optionally copy result to destination register */
    if (op != MVM_OP_sp_guardsf) {
        MVMint16 dest = guard->ins->operands[0].reg.orig;
        if (dest != obj) {
            MVMint32 dst_off = dest * (MVMint32)sizeof(MVMRegister);
            | str TMP1, [x21, #dst_off]
        }
    }
    | b >2
    |1:
    /* Deopt path */
    | mov ARG1, x19
    | mov ARG2, #guard->deopt_idx
    | callp &MVM_spesh_deopt_one
    | b ->exit
    |2:
}

void MVM_jit_emit_jumplist(MVMThreadContext *tc, MVMJitCompiler *compiler,
                           MVMJitGraph *jg, MVMJitJumpList *jumplist) {
    MVMint32 i;
    MVMint32 reg_off = jumplist->reg * (MVMint32)sizeof(MVMRegister);
    | ldr TMP1, [x21, #reg_off]
    | cmp TMP1, #0
    | blt >2
    | cmp TMP1, #jumplist->num_labels
    | bge >2
    /* Compute jump: each entry is one b-instruction = 4 bytes */
    | lsl TMP2, TMP1, #2
    | adr TMP3, >1
    | add TMP2, TMP3, TMP2
    | br TMP2
    |.align 4
    |1:
    for (i = 0; i < jumplist->num_labels; i++) {
        |=>(jumplist->in_labels[i]):
        | b =>(jumplist->out_labels[i])
    }
    |2:
}

void MVM_jit_emit_control(MVMThreadContext *tc, MVMJitCompiler *compiler,
                          MVMJitControl *ctrl, MVMJitTile *tile) {
    MVMJitControlType type = (tile != NULL ? (MVMJitControlType)tile->args[0] : ctrl->type);
    if (type == MVM_JIT_CONTROL_BREAKPOINT) {
        | brk #0
    } else {
        MVM_panic(1, "ARM64 JIT: unknown control code: <%s>", ctrl->ins->info->name);
    }
}

void MVM_jit_emit_data(MVMThreadContext *tc, MVMJitCompiler *compiler,
                       MVMJitData *data) {
    MVMuint8 *bytes = (MVMuint8 *)data->data;
    size_t i;
    | .data
    | =>(data->label):
    for (i = 0; i + 4 <= data->size; i += 4) {
        MVMuint32 packed = (MVMuint32)bytes[i] | ((MVMuint32)bytes[i+1]<<8) | ((MVMuint32)bytes[i+2]<<16) | ((MVMuint32)bytes[i+3]<<24);
        | .long packed
    }
    if (i < data->size) {
        MVMuint32 tail = 0; size_t j;
        for (j = 0; j < data->size - i; j++) tail |= ((MVMuint32)bytes[i+j] << (j*8));
        | .long tail
    }
    | .code
}

void MVM_jit_emit_load(MVMThreadContext *tc, MVMJitCompiler *compiler,
                       MVMint8 reg_dst, MVMJitStorageClass mem_cls,
                       MVMint32 mem_src, MVMint32 size) {
    if (mem_cls == MVM_JIT_STORAGE_LOCAL) {
        if (ARM64_IS_GPR(reg_dst)) {
            | ldr Rx(ARM64_GPR_NUM(reg_dst)), [x21, #mem_src]
        } else {
            | ldr Rd(ARM64_FPR_NUM(reg_dst)), [x21, #mem_src]
        }
    } else {
        MVM_oops(tc, "ARM64 JIT: emit_load: unsupported storage class %d", mem_cls);
    }
}

void MVM_jit_emit_store(MVMThreadContext *tc, MVMJitCompiler *compiler,
                        MVMJitStorageClass mem_cls, MVMint32 mem_pos,
                        MVMint8 reg_src, MVMint32 size) {
    if (mem_cls == MVM_JIT_STORAGE_LOCAL) {
        if (ARM64_IS_GPR(reg_src)) {
            | str Rx(ARM64_GPR_NUM(reg_src)), [x21, #mem_pos]
        } else {
            | str Rd(ARM64_FPR_NUM(reg_src)), [x21, #mem_pos]
        }
    } else {
        MVM_oops(tc, "ARM64 JIT: emit_store: unsupported storage class %d", mem_cls);
    }
}

void MVM_jit_emit_copy(MVMThreadContext *tc, MVMJitCompiler *compiler,
                       MVMint8 dst_reg, MVMint8 src_reg) {
    if (ARM64_IS_GPR(dst_reg)) {
        if (ARM64_IS_GPR(src_reg)) {
            | mov Rx(ARM64_GPR_NUM(dst_reg)), Rx(ARM64_GPR_NUM(src_reg))
        } else {
            | fmov Rx(ARM64_GPR_NUM(dst_reg)), Rd(ARM64_FPR_NUM(src_reg))
        }
    } else {
        if (ARM64_IS_FPR(src_reg)) {
            | fmov Rd(ARM64_FPR_NUM(dst_reg)), Rd(ARM64_FPR_NUM(src_reg))
        } else {
            | fmov Rd(ARM64_FPR_NUM(dst_reg)), Rx(ARM64_GPR_NUM(src_reg))
        }
    }
}

void MVM_jit_emit_marker(MVMThreadContext *tc, MVMJitCompiler *compiler,
                         MVMint32 num) {
    /* no-op for now; used for debug markers */
}

void MVM_jit_emit_deopt_check(MVMThreadContext *tc, MVMJitCompiler *compiler) {
    | ldr TMP6, TC->cur_frame
    | ldr TMP6, FRAME:TMP6->spesh_cand
    | cbz TMP6, ->exit
}

void MVM_jit_emit_runbytecode(MVMThreadContext *tc, MVMJitCompiler *compiler,
                              MVMJitGraph *jg, MVMJitRunByteCode *runcode) {
    MVMint32 code_off = runcode->code_register * (MVMint32)sizeof(MVMRegister);
    /* Uses pre-allocated space in the 160-byte prologue frame (sp never adjusted):
     * [sp+ 48..55]: MVMArgs.callsite
     * [sp+ 56..63]: MVMArgs.source  (= x21, current JIT frame's work)
     * [sp+ 64..71]: MVMArgs.map     (pointer to arg indices in JIT code data section)
     * [sp+ 72..79]: padding
     *
     * arg_indices are emitted into the JIT code data section (not the C stack)
     * so args.map remains valid after the JIT epilogue frees the C stack frame.
     */

    /* Set up frame return info */
    | get_cur_op TMP2
    | ldr TMP5, TC->cur_frame
    | str TMP2, FRAME:TMP5->return_address
    if (sizeof(MVMReturnType) == 1) {
        | mov TMP2, #runcode->return_type
        | strb w10, FRAME:TMP5->return_type
    } else {
        MVM_panic(1, "JIT: MVMReturnType has unexpected size");
    }
    if (runcode->return_type == MVM_RETURN_VOID) {
        | str xzr, FRAME:TMP5->return_value
    } else {
        MVMint32 rv_off = runcode->return_register * (MVMint32)sizeof(MVMRegister);
        | add TMP2, x21, #rv_off
        | str TMP2, FRAME:TMP5->return_value
    }

    | .data
    | 5:
    | .quad (uintptr_t)(runcode->callsite)
    | .code
    | ldr TMP6, <5
    | str TMP6, [sp, #48]
    | str x21, [sp, #56]

    /* Emit arg indices into data section; args.map points there.
     * Packed as pairs of uint16 into .long (4-byte) values, little-endian. */
    {
        MVMuint32 flag_count = runcode->callsite->flag_count;
        MVMuint32 fi;
        | .data
        | 8:
        for (fi = 0; fi + 2 <= flag_count; fi += 2) {
            MVMuint32 lo = (MVMuint16)runcode->map[fi].reg.orig;
            MVMuint32 hi = (MVMuint16)runcode->map[fi+1].reg.orig;
            MVMuint32 packed = lo + (hi << 16);
            | .long packed
        }
        if (flag_count & 1) {
            MVMuint32 last = (MVMuint16)runcode->map[flag_count-1].reg.orig;
            | .long last
        }
        | .code
        | adr TMP6, <8
        | str TMP6, [sp, #64]
    }

    | mov ARG1, x19
    | ldr ARG2, [x21, #code_off]
    | add ARG3, sp, #48
    | .data
    | 7:
    | .quad (uintptr_t)(runcode->spesh_cand)
    | .code
    | ldr ARG4, <7

    | .data
    | 6:
    | .quad (uintptr_t)(&MVM_frame_dispatch)
    | .code
    | ldr FUNCTION, <6
    | adr x17, >9
    | str x17, [sp, #40]
    | blr FUNCTION
    | ldr x17, [sp, #40]
    | br x17
    |9:
    /* NOTE: label 9 is the re-entry point that jit_return_address refers to.
     * The deopt label registered after this instruction (DEOPT_ALL_INS) must
     * land at exactly this address so that a deopt of a suspended frame maps
     * the re-entry position to the correct deopt_idx. Do NOT emit any
     * instructions between here and the end of this function. */
}

void MVM_jit_emit_runccode(MVMThreadContext *tc, MVMJitCompiler *compiler,
                           MVMJitGraph *jg, MVMJitRunCCode *runcode) {
    /* Uses pre-allocated space in the 160-byte prologue frame (sp never adjusted):
     * [sp+ 48..55]: MVMArgs.callsite
     * [sp+ 56..63]: MVMArgs.source  (= x21, current JIT frame's work)
     * [sp+ 64..71]: MVMArgs.map     (pointer to arg indices in JIT code data section)
     * [sp+ 72..79]: padding
     * [sp+ 40]:     trampoline slot — callp reads/writes here to intercept
     *               frame dispatches that happen inside the called function.
     *
     * arg_indices are emitted into the JIT code data section (not the C stack)
     * so args.map remains valid if a frame dispatch trampolines out.
     */

    /* Set up frame return info */
    | get_cur_op TMP2
    | ldr TMP5, TC->cur_frame
    | str TMP2, FRAME:TMP5->return_address
    if (sizeof(MVMReturnType) == 1) {
        | mov TMP2, #runcode->return_type
        | strb w10, FRAME:TMP5->return_type
    } else {
        MVM_panic(1, "JIT: MVMReturnType has unexpected size");
    }
    if (runcode->return_type == MVM_RETURN_VOID) {
        | str xzr, FRAME:TMP5->return_value
    } else {
        MVMint32 rv_off = runcode->return_register * (MVMint32)sizeof(MVMRegister);
        | add TMP2, x21, #rv_off
        | str TMP2, FRAME:TMP5->return_value
    }

    /* Build MVMArgs in the prologue's pre-allocated slots */
    | .data
    | 6:
    | .quad (uintptr_t)(runcode->callsite)
    | .code
    | ldr TMP6, <6
    | str TMP6, [sp, #48]
    | str x21, [sp, #56]

    /* Emit arg indices into data section; args.map points there.
     * Packed as pairs of uint16 into .long (4-byte) values, little-endian. */
    {
        MVMuint32 flag_count = runcode->callsite->flag_count;
        MVMuint32 fi;
        | .data
        | 8:
        for (fi = 0; fi + 2 <= flag_count; fi += 2) {
            MVMuint32 lo = (MVMuint16)runcode->map[fi].reg.orig;
            MVMuint32 hi = (MVMuint16)runcode->map[fi+1].reg.orig;
            MVMuint32 packed = lo + (hi << 16);
            | .long packed
        }
        if (flag_count & 1) {
            MVMuint32 last = (MVMuint16)runcode->map[flag_count-1].reg.orig;
            | .long last
        }
        | .code
        | adr TMP6, <8
        | str TMP6, [sp, #64]
    }

    | mov ARG1, x19
    | add ARG2, sp, #48

    /* Load the function address, then do an inline callp so the trampoline
     * can intercept any frame dispatch that occurs inside the function. */
    MVMSpeshFacts *function_facts =
        MVM_spesh_get_facts(tc, jg->sg, runcode->code_operand);
    if ((function_facts->flags & MVM_SPESH_FACT_KNOWN_VALUE) && function_facts->value.o) {
        uintptr_t call_target =
            (uintptr_t)(((MVMCFunction *)function_facts->value.o)->body.func);
        | .data
        | 7:
        | .quad call_target
        | .code
        | ldr FUNCTION, <7
    } else {
        MVMint32 code_op_off = runcode->code_operand.reg.orig * (MVMint32)sizeof(MVMRegister);
        | ldr FUNCTION, [x21, #code_op_off]
        | ldr FUNCTION, CFUNCTION:FUNCTION->body.func
    }
    | adr x17, >9
    | str x17, [sp, #40]
    | blr FUNCTION
    | ldr x17, [sp, #40]
    | br x17
    |9:
}

void MVM_jit_emit_runnativecall(MVMThreadContext *tc, MVMJitCompiler *compiler,
                                MVMJitGraph *jg, MVMJitRunNativeCall *runcode) {
    /* Set up frame return info */
    | get_cur_op TMP2
    | ldr TMP5, TC->cur_frame
    | str TMP2, FRAME:TMP5->return_address
    if (sizeof(MVMReturnType) == 1) {
        | mov TMP2, #runcode->return_type
        | strb w10, FRAME:TMP5->return_type
    } else {
        MVM_panic(1, "JIT: MVMReturnType has unexpected size");
    }
    if (runcode->return_type == MVM_RETURN_VOID) {
        | str xzr, FRAME:TMP5->return_value
    } else {
        MVMint32 rv_off = runcode->return_register * (MVMint32)sizeof(MVMRegister);
        | add TMP2, x21, #rv_off
        | str TMP2, FRAME:TMP5->return_value
    }

    /* Set up call arguments */
    MVMint32 nc_sp_adj = emit_arm64_callargs(tc, compiler, jg, runcode->args, runcode->num_args);

    /* Call the native function */
    | .data
    | 5:
    | .quad (MVMuint64)(uintptr_t)(runcode->entry_point)
    | .code
    | ldr FUNCTION, <5
    | blr FUNCTION
    if (nc_sp_adj > 0) {
        | add sp, sp, #nc_sp_adj
    }

    if (runcode->return_type != MVM_RETURN_VOID) {
        MVMint32 rv_off = runcode->return_register * (MVMint32)sizeof(MVMRegister);
        /* Sign-extend narrow integer return values */
        if (runcode->rv_type == MVM_NATIVECALL_ARG_CHAR) {
            | sxtb x0, x0
        } else if (runcode->rv_type == MVM_NATIVECALL_ARG_SHORT) {
            | sxth x0, x0
        } else if (runcode->rv_type == MVM_NATIVECALL_ARG_INT) {
            | sxtw x0, w0
        }
        /* Zero-extend narrow unsigned return values */
        if (runcode->rv_type == MVM_NATIVECALL_ARG_UCHAR) {
            | and x0, x0, #0xFF
        } else if (runcode->rv_type == MVM_NATIVECALL_ARG_USHORT) {
            | and x0, x0, #0xFFFF
        } else if (runcode->rv_type == MVM_NATIVECALL_ARG_UINT) {
            | and x0, x0, #0xFFFFFFFF
        } else if (runcode->rv_type == MVM_NATIVECALL_ARG_ULONG && sizeof(long) == 4) {
            | and x0, x0, #0xFFFFFFFF
        }
        | str RV, [x21, #rv_off]
    }
}

/* 8-arg wrapper for run_dispatch that hides the 9th stack arg (bytecode_offset).
 * ARM64 AAPCS64 requires the 9th arg at [SP] at call time, which would force
 * the JIT to do sub/add sp around the call and break the trampoline slot.
 * This thunk takes only register args and passes bytecode_offset=-1 internally. */
static void MVM_jit_dispatch_thunk(
        MVMThreadContext *tc,
        MVMDispInlineCacheEntry **entry_ptr,
        MVMDispInlineCacheEntry *seen,
        MVMString *id,
        MVMCallsite *callsite,
        MVMuint16 *arg_indices,
        MVMRegister *source,
        MVMStaticFrame *sf) {
    seen->run_dispatch(tc, entry_ptr, seen, id, callsite, arg_indices, source, sf, (MVMuint32)-1);
}

void MVM_jit_emit_dispatch(MVMThreadContext *tc, MVMJitCompiler *compiler,
                           MVMJitGraph *jg, MVMJitDispatch *dispatch) {
    MVMint16 i;
    MVMuint64 slot_off = (MVMuint64)dispatch->ice_slot * sizeof(void *);

    /* Arg map at label 7 (not 5: callp reuses label 5 for its function pointer) */
    | .data
    |7:
    {
        MVMuint32 flag_count = dispatch->callsite->flag_count;
        MVMuint32 fi;
        for (fi = 0; fi + 2 <= flag_count; fi += 2) {
            MVMuint32 packed = (MVMuint32)(MVMuint16)dispatch->map[fi].reg.orig | ((MVMuint32)(MVMuint16)dispatch->map[fi+1].reg.orig << 16);
            | .long packed
        }
        if (flag_count & 1) {
            MVMuint32 last = (MVMuint32)(MVMuint16)dispatch->map[flag_count-1].reg.orig;
            | .long last
        }
    }
    | .code

    /* Frame return setup */
    | get_cur_op TMP2
    | ldr TMP5, TC->cur_frame
    | str TMP2, FRAME:TMP5->return_address
    if (sizeof(MVMReturnType) == 1) {
        | mov TMP2, #dispatch->return_type
        | strb w10, FRAME:TMP5->return_type
    } else {
        MVM_panic(1, "JIT: MVMReturnType has unexpected size");
    }
    if (dispatch->return_type == MVM_RETURN_VOID) {
        | str xzr, FRAME:TMP5->return_value
    } else {
        MVMint32 rv_off = dispatch->return_register * (MVMint32)sizeof(MVMRegister);
        | add TMP2, x21, #rv_off
        | str TMP2, FRAME:TMP5->return_value
    }

    /* Build register args.
     * run_dispatch(tc, entry_ptr, seen, id, cs, arg_indices, source, sf, bytecode_offset)
     * x0-x7 = 8 register args; bytecode_offset = -1 on stack. */
    | mov ARG1, x19
    | get_spesh_slot TMP6, dispatch->sf_slot
    | ldr ARG2, STATICFRAME:TMP6->body.inline_cache.entries
    | .data
    | 8:
    | .quad slot_off
    | .code
    | ldr TMP3, <8
    | add ARG2, ARG2, TMP3
    | ldr ARG3, [ARG2]
    | get_string ARG4, dispatch->id
    | .data
    | 6:
    | .quad (uintptr_t)(dispatch->callsite)
    | .code
    | ldr ARG5, <6
    | adr ARG6, <7
    | mov x6, x21
    | mov x7, TMP6

    /* Call the 8-arg thunk via callp — sp stays at prologue_sp so the
     * trampoline slot [sp+40] is live.  The thunk passes bytecode_offset=-1
     * internally as a stack argument without disturbing our frame. */
    | callp &MVM_jit_dispatch_thunk
}

void MVM_jit_emit_istype(MVMThreadContext *tc, MVMJitCompiler *compiler,
                         MVMJitGraph *jg, MVMJitIsType *istype) {
    MVMuint64 slot_off;

    /* Try cache first */
    | mov ARG1, x19
    | ldr ARG2, [x21, #(istype->obj_register * sizeof(MVMRegister))]
    | ldr ARG3, [x21, #(istype->type_register * sizeof(MVMRegister))]
    | add ARG4, x21, #(istype->return_register * sizeof(MVMRegister))
    | callp &MVM_6model_try_cache_type_check

    | cbnz RV, =>(istype->reentry_label)

    /* Check for HLL istype dispatcher */
    {
        MVMStaticFrame *sf = (MVMStaticFrame *)jg->sg->spesh_slots[istype->sf_slot];
        MVMHLLConfig *hll = sf->body.cu->body.hll_config;
        if (hll->istype_dispatcher) {
            /* Arg map at label 3 (not 5: callp reuses label 5 for its function pointer) */
            | .data
            |3:
            {
                MVMuint32 packed = (MVMuint32)(MVMuint16)istype->obj_register | ((MVMuint32)(MVMuint16)istype->type_register << 16);
                | .long packed
            }
            | .code

            /* Frame return setup */
            | get_cur_op TMP2
            | ldr TMP5, TC->cur_frame
            | str TMP2, FRAME:TMP5->return_address
            | mov TMP2, #MVM_RETURN_INT
            | strb w10, FRAME:TMP5->return_type
            | add TMP2, x21, #(istype->return_register * sizeof(MVMRegister))
            | str TMP2, FRAME:TMP5->return_value

            slot_off = (MVMuint64)istype->ice_slot * sizeof(void *);
            | mov ARG1, x19
            | get_spesh_slot TMP6, istype->sf_slot
            | ldr ARG2, STATICFRAME:TMP6->body.inline_cache.entries
            | .data
            | 8:
            | .quad slot_off
            | .code
            | ldr TMP3, <8
            | add ARG2, ARG2, TMP3
            | ldr ARG3, [ARG2]
            MVMString **id_addr = &(hll->istype_dispatcher);
            | .data
            | 6:
            | .quad (uintptr_t)id_addr
            | .code
            | ldr ARG4, <6
            | ldr ARG4, [ARG4]
            MVMCallsite *callsite = MVM_callsite_get_common(tc, MVM_CALLSITE_ID_OBJ_OBJ);
            | .data
            | 7:
            | .quad (uintptr_t)callsite
            | .code
            | ldr ARG5, <7
            | adr ARG6, <3
            | mov x6, x21
            | mov x7, TMP6

            | callp &MVM_jit_dispatch_thunk
        }
    }
}

/* ---- Expression tile emit functions ------------------------------------ */
|.include src/jit/arm64/tiles.dasc
