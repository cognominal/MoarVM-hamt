        MVMint32 reg_a = ins->operands[0].reg.orig;
        MVMint32 reg_b = ins->operands[1].reg.orig;
        MVMint32 reg_c = ins->operands[2].reg.orig;
        MVMint32 dst_off = WORK_OFF(reg_a);
        MVMint32 src_b = WORK_OFF(reg_b);
        MVMint32 src_c = WORK_OFF(reg_c);
        | ldr TMP1, [x21, #src_b]
        | ldr TMP2, [x21, #src_c]
        switch (op) {
        case MVM_OP_add_i:
            | add TMP1, TMP1, TMP2
            break;
        case MVM_OP_sub_i:
            | sub TMP1, TMP1, TMP2
            break;
        case MVM_OP_bor_i:
            | orr TMP1, TMP1, TMP2
            break;
        case MVM_OP_band_i:
            | and TMP1, TMP1, TMP2
            break;
        case MVM_OP_bxor_i:
            | eor TMP1, TMP1, TMP2
            break;
        }
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_mul_i:
    case MVM_OP_blshift_i:
    case MVM_OP_brshift_i: {
        MVMint32 reg_a = ins->operands[0].reg.orig;
        MVMint32 reg_b = ins->operands[1].reg.orig;
        MVMint32 reg_c = ins->operands[2].reg.orig;
        MVMint32 dst_off = WORK_OFF(reg_a);
        MVMint32 src_b = WORK_OFF(reg_b);
        MVMint32 src_c = WORK_OFF(reg_c);
        | ldr TMP1, [x21, #src_b]
        | ldr TMP2, [x21, #src_c]
        switch (op) {
        case MVM_OP_mul_i:
            | mul TMP1, TMP1, TMP2
            break;
        case MVM_OP_blshift_i:
            | lsl TMP1, TMP1, TMP2
            break;
        case MVM_OP_brshift_i:
            | asr TMP1, TMP1, TMP2
            break;
        }
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_pow_i: {
        MVMint16 dst  = ins->operands[0].reg.orig;
        MVMint16 base = ins->operands[1].reg.orig;
        MVMint16 exp  = ins->operands[2].reg.orig;
        MVMint32 dst_off  = WORK_OFF(dst);
        MVMint32 base_off = WORK_OFF(base);
        MVMint32 exp_off  = WORK_OFF(exp);
        | ldr TMP2, [x21, #exp_off]
        | cmp TMP2, #0
        | blt >3
        | mov TMP1, #1
        | ldr TMP3, [x21, #base_off]
        |1:
        | tbz TMP2, #0, >2
        | mul TMP1, TMP1, TMP3
        |2:
        | mul TMP3, TMP3, TMP3
        | lsr TMP2, TMP2, #1
        | cbnz TMP2, <1
        |3:
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_div_i: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 a   = ins->operands[1].reg.orig;
        MVMint16 b   = ins->operands[2].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 a_off   = WORK_OFF(a);
        MVMint32 b_off   = WORK_OFF(b);
        | ldr TMP1, [x21, #a_off]
        | ldr TMP2, [x21, #b_off]
        | cbnz TMP2, >1
        | throw_adhoc "Division by zero"
        |1:
        | sdiv TMP3, TMP1, TMP2
        /* floor division: adjust if remainder != 0 and signs differ */
        | msub TMP4, TMP3, TMP2, TMP1
        | cbz TMP4, >2
        | eor TMP4, TMP1, TMP2
        | tbz TMP4, #63, >2
        | sub TMP3, TMP3, #1
        |2:
        | str TMP3, [x21, #dst_off]
        break;
    }
    case MVM_OP_mod_i: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 a   = ins->operands[1].reg.orig;
        MVMint16 b   = ins->operands[2].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 a_off   = WORK_OFF(a);
        MVMint32 b_off   = WORK_OFF(b);
        | ldr TMP1, [x21, #a_off]
        | ldr TMP2, [x21, #b_off]
        | cbnz TMP2, >1
        | throw_adhoc "Division by zero"
        |1:
        | sdiv TMP3, TMP1, TMP2
        | msub TMP3, TMP3, TMP2, TMP1
        | str TMP3, [x21, #dst_off]
        break;
    }
    case MVM_OP_inc_u:
    case MVM_OP_inc_i: {
        MVMint32 reg = ins->operands[0].reg.orig;
        MVMint32 off = WORK_OFF(reg);
        | ldr TMP1, [x21, #off]
        | add TMP1, TMP1, #1
        | str TMP1, [x21, #off]
        break;
    }
    case MVM_OP_dec_u:
    case MVM_OP_dec_i: {
        MVMint32 reg = ins->operands[0].reg.orig;
        MVMint32 off = WORK_OFF(reg);
        | ldr TMP1, [x21, #off]
        | sub TMP1, TMP1, #1
        | str TMP1, [x21, #off]
        break;
    }
    case MVM_OP_bnot_i: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 src_off = WORK_OFF(src);
        | ldr TMP1, [x21, #src_off]
        | mvn TMP1, TMP1
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_neg_i: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 src_off = WORK_OFF(src);
        | ldr TMP1, [x21, #src_off]
        | neg TMP1, TMP1
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_abs_i: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 src_off = WORK_OFF(src);
        | ldr TMP1, [x21, #src_off]
        | cmp TMP1, #0
        | cneg TMP1, TMP1, mi
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_extend_i8: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 src_off = WORK_OFF(src);
        | ldr TMP1, [x21, #src_off]
        | sxtb TMP1, TMP1
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_extend_u8: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 src_off = WORK_OFF(src);
        | ldr TMP1, [x21, #src_off]
        | uxtb w9, w9
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_extend_i16: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 src_off = WORK_OFF(src);
        | ldr TMP1, [x21, #src_off]
        | sxth TMP1, TMP1
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_extend_u16: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 src_off = WORK_OFF(src);
        | ldr TMP1, [x21, #src_off]
        | uxth w9, w9
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_extend_i32: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 src_off = WORK_OFF(src);
        | ldr TMP1, [x21, #src_off]
        | sxtw TMP1, w9
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_extend_u32: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 src_off = WORK_OFF(src);
        | ldr TMP1, [x21, #src_off]
        | mov w9, w9
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_trunc_u8:
    case MVM_OP_trunc_i8: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 src_off = WORK_OFF(src);
        | ldr TMP1, [x21, #src_off]
        | uxtb w9, w9
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_trunc_u16:
    case MVM_OP_trunc_i16: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 src_off = WORK_OFF(src);
        | ldr TMP1, [x21, #src_off]
        | uxth w9, w9
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_trunc_u32:
    case MVM_OP_trunc_i32: {
        MVMint16 dst = ins->operands[0].reg.orig;
        MVMint16 src = ins->operands[1].reg.orig;
        MVMint32 dst_off = WORK_OFF(dst);
        MVMint32 src_off = WORK_OFF(src);
        | ldr TMP1, [x21, #src_off]
        | mov w9, w9
        | str TMP1, [x21, #dst_off]
        break;
    }
    case MVM_OP_sp_istrue_n: {
