        case MVM_OP_sub_n:
            | fsub d0, d0, d1
            break;
        case MVM_OP_mul_n:
            | fmul d0, d0, d1
            break;
        case MVM_OP_div_n:
            | fdiv d0, d0, d1
            break;
        }
