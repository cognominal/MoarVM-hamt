{
    "env": {
        "PersistableDefines" : [ "HAMT_PERSISTABLE", "HAMT_CONTEXTUAL"],
        "NonPersistableDefines" : []

    },
    "configurations": [
        {
            "name": "Mac-Persistable",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": ["${PersistableDefines}"],
            "macFrameworkPath": [
                "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64"
        },
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/**"
            ],
            "defines": [],
            "macFrameworkPath": [
                "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/System/Library/Frameworks"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64"
        }

    ],
    "version": 4
}